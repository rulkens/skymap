# Cloudflare Workers Assets header rules for skymap.
#
# Long-cache the hash-fingerprinted JS/CSS/WGSL/WASM assets — Vite emits
# them with content hashes in the filename, so a one-year immutable cache
# is safe.  Any code change produces a new filename and the old one falls
# out of cache naturally.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.wgsl
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Cache-Control: public, max-age=31536000, immutable

# Famous-galaxy thumbnails — not hash-fingerprinted (the URL is part of
# the seed JSON and stable), so cap at one day to allow refreshes if the
# atlas is regenerated.
/images/famous/*.webp
  Cache-Control: public, max-age=86400

# Belt-and-braces only: `npm run build` ends in `rm -rf dist/data`, so in
# production every data byte is served from R2 under the buildGroups()
# policy in tools/deploy/syncR2.ts — that group cacheControl is the
# load-bearing edit. These rules only reach public/data/ under a local
# `vite preview`. Both match manifest.json; Cloudflare's docs say the more
# specific (exact-path) rule wins a duplicate header, so it's listed last
# to win over the wildcard — unverified against a live deploy, so treat it
# as an assumption, not a guarantee.
/data/*
  Cache-Control: public, max-age=31536000, immutable

/data/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
