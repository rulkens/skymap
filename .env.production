# Production env consumed by `vite build` (Cloudflare's GitHub integration runs
# this command on every push to `main`).  Vite inlines `VITE_*` variables into
# the compiled bundle at build time, so `dataUrl()` in cloudLoader.ts resolves
# to the R2 custom-domain host instead of the relative `/data/` path.
#
# Dev intentionally leaves this unset (no `.env.development`), so `dataUrl()`
# falls back to the empty string and Vite serves `public/data/*.bin` directly.
VITE_DATA_BASE_URL=https://data.skymap.rulkens.com
