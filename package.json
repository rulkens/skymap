{
  "name": "skymap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build-all": "tsx tools/buildAllBins.ts --sdss \"data/Skyserver_SQL5_3_2026 10_23_35 AM.csv\" --twomrs data/raw/2mrs_table3.dat --glade data/raw/glade2.3.dat --out-dir public/data",
    "csv-to-bin": "tsx tools/csvToBin.ts",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.tools.json"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@webgpu/types": "0.1.69",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "gl-matrix": "3.4.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  }
}
