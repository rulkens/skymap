{
  "name": "skymap",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Alexander Rulkens <rulkens@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rulkens/skymap.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build-all": "tsx tools/buildAllBins.ts",
    "build-famous": "tsx tools/buildFamous.ts",
    "deploy": "npm run build && firebase deploy --only hosting --project skymap-b8e3e",
    "expand-famous": "tsx tools/expandFamousFromCatalogs.ts",
    "csv-to-bin": "tsx tools/csvToBin.ts",
    "dev": "vite",
    "fetch-2mass-xsc": "tsx tools/fetch2massXsc.ts",
    "fetch-famous-images": "tsx tools/fetchFamousImages.ts",
    "fetch-hyperleda": "tsx tools/fetchHyperLeda.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.tools.json"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "@webgpu/types": "0.1.69",
    "firebase-tools": "13.29.1",
    "prettier": "3.8.3",
    "sharp": "0.34.5",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "gl-matrix": "3.4.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  }
}
