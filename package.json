{
  "name": "skymap",
  "version": "0.4.0",
  "private": true,
  "description": "Interactive WebGPU 3D explorer for the SDSS, GLADE, and 2MRS galaxy catalogs.",
  "license": "MIT",
  "author": "Alexander Rulkens <rulkens@gmail.com>",
  "homepage": "https://skymap.rulkens.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/rulkens/skymap.git"
  },
  "bugs": {
    "url": "https://github.com/rulkens/skymap/issues"
  },
  "keywords": [
    "webgpu",
    "astronomy",
    "galaxies",
    "sdss",
    "glade",
    "2mrs",
    "cosmology",
    "visualization",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && rm -rf dist/data && npm run galaxy-renderer:build && npm run mcpm-workbench:build && npm run flow-workbench:build",
    "build-data-manifest": "tsx tools/deploy/buildDataManifest.ts",
    "build-all": "tsx tools/catalog/buildAllBins.ts && npm run build-data-manifest",
    "build-cf4-density": "tsx tools/volumes/buildCf4Density.ts && npm run build-data-manifest",
    "build-earth-tiles": "tsx tools/textures/buildEarthTiles.ts",
    "build-flow-field": "tsx tools/flow/buildFlowField.ts && npm run build-data-manifest",
    "verify-flow-field": "tsx tools/flow/verifyFlowField.ts",
    "build-structures": "tsx tools/structures/buildStructures.ts && npm run build-data-manifest",
    "build-mcpm": "tsx tools/volumes/buildMcpmVolume.ts --all && npm run build-data-manifest",
    "promote-mcpm-workbench": "tsx tools/volumes/promoteWorkbenchExport.ts",
    "build-dust": "tsx tools/volumes/buildDustVolume.ts --all && npm run build-data-manifest",
    "build-stars": "NODE_OPTIONS=--max-old-space-size=16384 tsx tools/stars/buildStars.ts && npm run build-data-manifest",
    "build-stars-rs": "cargo run --manifest-path tools/stars-rs/Cargo.toml --release -- --out public/data && npm run build-data-manifest",
    "build-famous": "tsx tools/famous/buildFamous.ts && npm run build-data-manifest",
    "build-famous-stars": "tsx tools/famous/buildFamousStars.ts && npm run build-data-manifest",
    "build-planet-facts": "tsx tools/bodies/buildPlanetFacts.ts",
    "build-famous-hires": "tsx tools/famous/copyHiResToPublic.ts",
    "build-famous-thumbs": "tsx tools/famous/buildFamousThumbs.ts",
    "build-pgc-aliases": "tsx tools/fetch/buildPgcAliases.ts",
    "build-filaments": "tsx tools/filaments/buildFilaments.ts && npm run build-data-manifest",
    "build-filaments-sdss": "tsx tools/filaments/buildFilaments.ts --sources sdss --output public/data/filament/v1/filaments-sdss.bin && npm run build-data-manifest",
    "build-filaments-small": "tsx tools/filaments/buildFilaments.ts --cut 7 --output public/data/filament/v1/filaments-small.bin && npm run build-data-manifest",
    "build-fonts": "tsx tools/fonts/buildFontAtlas.ts",
    "build-tiers": "tsx tools/catalog/buildAllBins.ts && npm run build-data-manifest",
    "build-textures": "tsx tools/textures/buildTextures.ts",
    "tour-length": "tsx tools/animation/tourLength.ts",
    "flow-workbench": "vite --config tools/flow-workbench/vite.config.ts",
    "flow-workbench:build": "vite build --config tools/flow-workbench/vite.config.ts",
    "galaxy-renderer": "vite --config tools/galaxy-renderer/vite.config.ts",
    "galaxy-renderer:build": "vite build --config tools/galaxy-renderer/vite.config.ts",
    "galaxy-renderer:probe": "tsx tools/galaxy-renderer/probeGpuErrors.ts",
    "mcpm-workbench": "vite --config tools/mcpm-workbench/vite.config.ts",
    "mcpm-workbench:build": "vite build --config tools/mcpm-workbench/vite.config.ts",
    "mcpm-workbench:probe": "tsx tools/mcpm-workbench/probeGpuErrors.ts",
    "mcpm-workbench:compare": "tsx tools/mcpm-workbench/validate/compareTraceCubes.ts",
    "curate-famous": "vite --config tools/famous-curator/vite.config.ts",
    "deploy": "git push origin main && echo 'Pushed.  Cloudflare Workers Assets is rebuilding — watch https://dash.cloudflare.com/?to=/:account/workers-and-pages'",
    "desi-cone-census": "tsx tools/catalog/desiConeCensus.ts",
    "expand-famous": "tsx tools/famous/expandFamousFromCatalogs.ts",
    "famous-seed-from-leda": "tsx tools/famous/famousSeedFromHyperleda.ts",
    "predev": "tsx tools/dev/stagePgcAliases.ts && npm run build-data-manifest",
    "dev": "vite",
    "fetch-2mass-xsc": "tsx tools/fetch/fetch2massXsc.ts",
    "fetch-cf4": "tsx tools/fetch/fetchCosmicflows4.ts",
    "fetch-desi": "tsx tools/fetch/fetchDesi.ts",
    "fetch-eox": "tsx tools/fetch/fetchEoxTiles.ts",
    "fetch-structures": "tsx tools/fetch/fetchStructureCatalogs.ts",
    "fetch-famous-images": "tsx tools/famous/fetchFamousImages.ts",
    "fetch-gaia": "tsx tools/fetch/fetchGaia.ts",
    "fetch-hyperleda": "tsx tools/fetch/fetchHyperLeda.ts",
    "fetch-milliquas": "tsx tools/fetch/fetchMilliquas.ts",
    "fetch-textures": "tsx tools/fetch/fetchTextures.ts",
    "fit-pluto-chroma": "tsx tools/textures/fitPlutoChroma.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "move-files": "tsx tools/dev/moveFiles.ts",
    "perf": "tsx tools/perf/measurePerf.ts",
    "preview": "vite preview",
    "r2-cors": "npx wrangler r2 bucket cors set skymap-data --file tools/deploy/r2Cors.json",
    "record-clip": "tsx tools/record/record.ts --clip",
    "record-tour": "tsx tools/record/record.ts",
    "refactor": "tsx tools/refactor/refactor.ts",
    "spike-virtual-time": "tsx tools/record/virtualTimeSpike.ts",
    "sync-r2": "tsx tools/deploy/syncR2.ts",
    "sync-r2-secure": "bash tools/deploy/syncR2Secure.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.tools.json"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@playwright/test": "1.59.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "@webgpu/types": "0.1.69",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "27.0.1",
    "msdf-bmfont-xml": "2.8.0",
    "prettier": "3.8.3",
    "sharp": "0.35.3",
    "ts-morph": "28.0.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.1",
    "vitest": "4.1.5",
    "wesl": "0.7.26",
    "wesl-plugin": "0.6.74",
    "wrangler": "4.123.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "classnames": "2.5.1",
    "hotkeys-js": "4.0.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "10.1.0",
    "react-redux": "9.3.0",
    "redux-saga": "1.5.0",
    "typed-redux-saga": "1.5.0",
    "wgpu-matrix": "3.4.2"
  }
}
