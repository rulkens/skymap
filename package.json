{
  "name": "skymap",
  "version": "0.3.0",
  "private": true,
  "description": "Interactive WebGPU 3D explorer for the SDSS, GLADE, and 2MRS galaxy catalogs.",
  "license": "MIT",
  "author": "Alexander Rulkens <rulkens@gmail.com>",
  "homepage": "https://skymap.rulkens.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/rulkens/skymap.git"
  },
  "bugs": {
    "url": "https://github.com/rulkens/skymap/issues"
  },
  "keywords": [
    "webgpu",
    "astronomy",
    "galaxies",
    "sdss",
    "glade",
    "2mrs",
    "cosmology",
    "visualization",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && rm -rf dist/data",
    "build-all": "tsx tools/buildAllBins.ts",
    "build-cf4-density": "tsx tools/buildCf4Density.ts",
    "build-mcpm": "tsx tools/buildMcpmVolume.ts --all",
    "build-famous": "tsx tools/buildFamous.ts",
    "build-pgc-aliases": "tsx tools/buildPgcAliases.ts",
    "build-filaments": "tsx tools/buildFilaments.ts",
    "build-filaments-sdss": "tsx tools/buildFilaments.ts --sources sdss --output public/data/filaments-sdss.bin",
    "build-filaments-small": "tsx tools/buildFilaments.ts --cut 7 --output public/data/filaments-small.bin",
    "build-fonts": "tsx tools/buildFontAtlas.ts",
    "build-tiers": "tsx tools/buildAllBins.ts",
    "deploy": "git push origin main && echo 'Pushed.  Cloudflare Workers Assets is rebuilding — watch https://dash.cloudflare.com/?to=/:account/workers-and-pages'",
    "expand-famous": "tsx tools/expandFamousFromCatalogs.ts",
    "csv-to-bin": "tsx tools/csvToBin.ts",
    "dev": "vite",
    "fetch-2mass-xsc": "tsx tools/fetch2massXsc.ts",
    "fetch-famous-images": "tsx tools/fetchFamousImages.ts",
    "fetch-hyperleda": "tsx tools/fetchHyperLeda.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "r2-cors": "npx wrangler r2 bucket cors set skymap-data --file tools/r2Cors.json",
    "sync-r2": "tsx tools/syncR2.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.tools.json"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "@webgpu/types": "0.1.69",
    "jsdom": "27.0.1",
    "msdf-bmfont-xml": "2.8.0",
    "prettier": "3.8.3",
    "sharp": "0.34.5",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5",
    "wesl": "0.7.26",
    "wesl-plugin": "0.6.74",
    "wrangler": "4.87.0"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "gl-matrix": "3.4.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  }
}
