index 000000000..0bb2edb5c
--- /dev/null
+++ b/src/services/engine/spike/limitingMagSpikeParams.ts
@@ -0,0 +1,65 @@
+/**
+ * limitingMagSpikeParams — SPIKE (throwaway A/B), do NOT build on this.
+ *
+ * A module-level mutable record holding the live-tunable parameters for the
+ * experimental limiting-magnitude intensity curve in `points/vertex.wesl`.
+ * It exists only so a dev-only overlay panel can A/B the new look against the
+ * legacy intensity path in the browser without any Redux/settings plumbing —
+ * the whole feature is expected to be replaced by a real settings-backed
+ * implementation once the design (docs/superpowers/specs/2026-07-10-
+ * distant-galaxy-fading-design.md) is validated. Everything here is additive
+ * and marked SPIKE.
+ *
+ * `pointSpritesLayer` reads `limitingMagSpikeParams` every frame while
+ * assembling `PointDrawSettings`. The panel mutates the record in place and
+ * calls `setLimitingMagSpikeParams`, which pokes the render scheduler so the
+ * change is visible immediately on an otherwise-idle (render-on-demand) loop.
+ *
+ * The render-on-demand scheduler is created per-engine, not a global, so the
+ * engine registers its `requestRender` here at startup via
+ * `registerLimitingMagSpikeWake`. Until it does, mutations still land in the
+ * record; they simply won't force a frame (harmless — the next real wake picks
+ * them up).
+ */
+
+/** SPIKE: live parameters for the limiting-magnitude intensity curve. */
+export type LimitingMagSpikeParams = {
+  enabled: boolean;
+  depth: number;
+  softness: number;
+  k: number;
+  sparseOffset: number;
+  // SPIKE: live camera scene-scale (Mpc), written each frame by the points
+  // layer as a plain field (NO wake — it must not trigger renders). The panel
+  // reads it to reparameterize (depth, k) around the perceived limiting mag at
+  // the current zoom. Not a tunable; a one-way readout from engine → panel.
+  sceneScaleMpc: number;
+};
+
+/** SPIKE: the single mutable record read by the points layer each frame. */
+export const limitingMagSpikeParams: LimitingMagSpikeParams = {
+  enabled: false,
+  depth: 8,
+  softness: 1.5,
+  k: 5,
+  sparseOffset: -8,
+  sceneScaleMpc: 1,
+};
+
+// SPIKE: the engine's per-frame render request, registered at startup. Null
+// until the engine wires it (see startLoop.ts).
+let wake: (() => void) | null = null;
+
+/** SPIKE: engine hook — register the render scheduler's requestRender. */
+export function registerLimitingMagSpikeWake(fn: (() => void) | null): void {
+  wake = fn;
+}
+
+/**
+ * SPIKE: apply a partial update to the live params and request a render so the
+ * change shows immediately on the render-on-demand loop.
+ */
+export function setLimitingMagSpikeParams(patch: Partial<LimitingMagSpikeParams>): void {
+  Object.assign(limitingMagSpikeParams, patch);
+  wake?.();
+}
