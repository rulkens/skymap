diff --git a/src/components/LimitingMagSpikePanel/LimitingMagSpikePanel.tsx b/src/components/LimitingMagSpikePanel/LimitingMagSpikePanel.tsx
new file mode 100644
index 000000000..86050e08a
--- /dev/null
+++ b/src/components/LimitingMagSpikePanel/LimitingMagSpikePanel.tsx
@@ -0,0 +1,210 @@
+/**
+ * LimitingMagSpikePanel — SPIKE (throwaway A/B), dev-only.
+ *
+ * A tiny fixed-position overlay (bottom-left, clear of the right-hand settings
+ * panel) that live-tunes the experimental limiting-magnitude intensity curve in
+ * `points/vertex.wesl`. It writes through `setLimitingMagSpikeParams`, which
+ * mutates the module singleton the points layer reads each frame and pokes the
+ * render scheduler so the change shows immediately.
+ *
+ * ### Perception reparameterization
+ *
+ * Raw (depth, k) are miserable to tune by hand: the shader forms
+ * `mLim = depth + k * log10(sceneScale)`, so the two knobs are coupled through
+ * the live camera distance. Instead the panel drives them via what the eye
+ * actually judges:
+ *
+ *   - 'Limit here' sets the EFFECTIVE limiting mag at the current zoom
+ *     (`mLimHere = depth + k * log10(sceneScale)`); dragging back-solves
+ *     `depth = mLimHere - k * log10(sceneScale)` with k held fixed. The
+ *     slider's shown value is derived from live (depth, k, sceneScale), not
+ *     stored — so it tracks as you fly.
+ *   - The A/B anchor workflow captures two (log10 distance, mLimHere) points
+ *     at two zooms, then fits the line through them: `k = Δy/Δx`,
+ *     `depth = yA - k·xA`. That lets you say "this bright here, that faint out
+ *     there" and have the slope fall out.
+ *
+ * `sceneScale` is published engine → panel via `limitingMagSpikeParams
+ * .sceneScaleMpc` (written every frame by the points layer, no wake); the
+ * panel polls it on a cheap 250 ms interval so readouts + the 'Limit here'
+ * value stay live as the camera moves.
+ *
+ * Mounted only under `import.meta.env.DEV` (see App.tsx). Deliberately minimal
+ * and self-contained — it is expected to be deleted once the design is
+ * validated and a real settings-backed implementation lands.
+ */
+
+import { useEffect, useState } from 'react';
+import {
+  limitingMagSpikeParams,
+  setLimitingMagSpikeParams,
+} from '../../services/engine/spike/limitingMagSpikeParams';
+import { formatDistance } from '../../utils/format/formatDistance';
+import styles from './LimitingMagSpikePanel.module.css';
+
+// SPIKE: a captured (log10 distance, effective mLim) sample for the A/B fit.
+type Anchor = { x: number; y: number };
+
+function LimitingMagSpikePanel() {
+  // Local mirror of the tunable singleton fields so the controls are
+  // controlled; each change also writes through + wakes the render loop.
+  const [enabled, setEnabled] = useState(limitingMagSpikeParams.enabled);
+  const [softness, setSoftness] = useState(limitingMagSpikeParams.softness);
+  const [sparseOffset, setSparseOffset] = useState(limitingMagSpikeParams.sparseOffset);
+  // depth + k are now DERIVED (back-solved from 'Limit here' / the A/B fit),
+  // not slider-driven — we mirror them so the readouts + slider math re-render.
+  const [depth, setDepth] = useState(limitingMagSpikeParams.depth);
+  const [k, setK] = useState(limitingMagSpikeParams.k);
+
+  // Live scene-scale, polled from the singleton (engine writes it each frame,
+  // no wake). Drives the 'Limit here' value + distance readout as we fly.
+  const [sceneScaleMpc, setSceneScaleMpc] = useState(limitingMagSpikeParams.sceneScaleMpc);
+  useEffect(() => {
+    const id = setInterval(() => {
+      setSceneScaleMpc(limitingMagSpikeParams.sceneScaleMpc);
+    }, 250);
+    return () => clearInterval(id);
+  }, []);
+
+  const [anchorA, setAnchorA] = useState<Anchor | null>(null);
+  const [anchorB, setAnchorB] = useState<Anchor | null>(null);
+
+  // sceneScaleMpc is >= 1 from the engine, so log10 >= 0.
+  const logScale = Math.log10(sceneScaleMpc);
+  const mLimHere = depth + k * logScale;
+
+  // A/B fit: when both anchors are set and their x's are far enough apart,
+  // fit the line through them and write (depth, k) to the singleton.
+  const bothAnchors = anchorA !== null && anchorB !== null;
+  const anchorsTooClose =
+    bothAnchors && Math.abs((anchorB as Anchor).x - (anchorA as Anchor).x) <= 0.05;
+  useEffect(() => {
+    if (anchorA === null || anchorB === null) return;
+    const dx = anchorB.x - anchorA.x;
+    if (Math.abs(dx) <= 0.05) return; // too close; render shows a hint instead
+    const rawK = (anchorB.y - anchorA.y) / dx;
+    const solvedDepth = anchorA.y - rawK * anchorA.x;
+    const clampedK = Math.min(12, Math.max(0, rawK));
+    setK(clampedK);
+    setDepth(solvedDepth);
+    setLimitingMagSpikeParams({ k: clampedK, depth: solvedDepth });
+  }, [anchorA, anchorB]);
+
+  const captureAnchor = (set: (a: Anchor) => void) => {
+    set({ x: logScale, y: mLimHere });
+  };
+
+  return (
+    <div className={styles.root}>
+      <div className={styles.title}>Limiting-mag spike</div>
+
+      <label className={styles.checkRow}>
+        <input
+          type="checkbox"
+          checked={enabled}
+          onChange={(e) => {
+            setEnabled(e.target.checked);
+            setLimitingMagSpikeParams({ enabled: e.target.checked });
+          }}
+        />
+        enabled
+      </label>
+
+      <label className={styles.row}>
+        <span>limit here</span>
+        <input
+          type="range"
+          min={5}
+          max={30}
+          step={0.1}
+          value={Math.min(30, Math.max(5, mLimHere))}
+          onChange={(e) => {
+            const target = Number(e.target.value);
+            // Back-solve depth so the effective mLim equals the slider, k held.
+            const newDepth = target - k * logScale;
+            setDepth(newDepth);
+            setLimitingMagSpikeParams({ depth: newDepth });
+          }}
+        />
+        <span className={styles.value}>{mLimHere.toFixed(1)}</span>
+      </label>
+
+      <div className={styles.anchors}>
+        <div className={styles.btnRow}>
+          <button type="button" onClick={() => captureAnchor(setAnchorA)}>
+            Set anchor A
+          </button>
+          <button type="button" onClick={() => captureAnchor(setAnchorB)}>
+            Set anchor B
+          </button>
+          <button
+            type="button"
+            onClick={() => {
+              setAnchorA(null);
+              setAnchorB(null);
+            }}
+          >
+            Clear
+          </button>
+        </div>
+        {anchorA !== null && (
+          <div className={styles.readout}>
+            A: {formatDistance(10 ** anchorA.x)} → m {anchorA.y.toFixed(2)}
+          </div>
+        )}
+        {anchorB !== null && (
+          <div className={styles.readout}>
+            B: {formatDistance(10 ** anchorB.x)} → m {anchorB.y.toFixed(2)}
+          </div>
+        )}
+        {anchorsTooClose && (
+          <div className={styles.hint}>anchors too close — fly further out/in</div>
+        )}
+      </div>
+
+      <label className={styles.row}>
+        <span>softness</span>
+        <input
+          type="range"
+          min={0.25}
+          max={4}
+          step={0.05}
+          value={softness}
+          onChange={(e) => {
+            const v = Number(e.target.value);
+            setSoftness(v);
+            setLimitingMagSpikeParams({ softness: v });
+          }}
+        />
+        <span className={styles.value}>{softness.toFixed(2)}</span>
+      </label>
+
+      <label className={styles.row}>
+        <span>sparseOffset</span>
+        <input
+          type="range"
+          min={-15}
+          max={0}
+          step={0.5}
+          value={sparseOffset}
+          onChange={(e) => {
+            const v = Number(e.target.value);
+            setSparseOffset(v);
+            setLimitingMagSpikeParams({ sparseOffset: v });
+          }}
+        />
+        <span className={styles.value}>{sparseOffset.toFixed(1)}</span>
+      </label>
+
+      <div className={styles.readouts}>
+        <div className={styles.readout}>cam {formatDistance(sceneScaleMpc)}</div>
+        <div className={styles.readout}>m_lim {mLimHere.toFixed(2)}</div>
+        <div className={styles.readout}>
+          depth {depth.toFixed(2)} · k {k.toFixed(2)}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+export default LimitingMagSpikePanel;
