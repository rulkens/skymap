# Desktop-app env consumed by `vite build --mode desktop` (packages/desktop `dist`).
# The bundle is served from the app's own local server, which mirrors the
# bucket's `data/` tree, so the data base URL stays empty and `dataUrl()` in
# cloudLoader.ts resolves to the relative `/data/` path.
#
# No `VITE_COUNTERSCALE_URL` on purpose: the kiosk runs offline and must not
# phone home, and injectAnalytics() injects nothing when it is undefined.
VITE_DATA_BASE_URL=
