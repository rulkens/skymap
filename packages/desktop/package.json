{
  "name": "@skymap/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "build/main/main.cjs",
  "scripts": {
    "build": "esbuild src/main/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=build/main/main.cjs",
    "dev": "npm run build && electron . --windowed",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "vite build --mode desktop --root ../.. && npm run build && electron-builder --mac --win"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "electron": "44.9.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "selfsigned": "5.5.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
