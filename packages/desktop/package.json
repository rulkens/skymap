{
  "name": "@skymap/desktop",
  "productName": "Skymap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "build/main/main.cjs",
  "scripts": {
    "build": "vite build --mode control && vite build --mode preload && vite build --mode main",
    "brand": "tsx scripts/buildBrandAssets.ts",
    "dev": "npm run build && tsx scripts/runDev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "cd ../.. && vite build --mode desktop && cd packages/desktop && npm run brand && npm run build && electron-builder --mac --win"
  },
  "devDependencies": {
    "@fontsource-variable/jost": "5.3.0",
    "@types/node": "25.6.0",
    "electron": "44.9.2",
    "electron-builder": "26.18.0",
    "selfsigned": "5.5.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
