---
import Base from '../layouts/Base.astro';
import ObjLink from '../components/ObjLink.astro';
import Shot from '../components/Shot.astro';
import ShotCaption from '../components/ShotCaption.astro';
import Sources from '../components/Sources.astro';
import { appLink } from '../data/appLink';
import { siteShot } from '../data/siteShot';
import { sitePath } from '../utils/sitePath';
---

<Base title="Page not found: skymap" description="This address is not on the map. The way back to skymap starts here.">
  <section class="lost">
    <div class="back">
      <Shot id="void-bootes" sizes="100vw" eager />
    </div>
    <div class="wrap copy">
      <h1>There is nothing here</h1>
      <p class="say">
        This address is not on the map. The picture is the Boötes Void, found in 1981 and described as a
        million cubic megaparsecs of very little. You are in suitable company.
      </p>
      <ObjLink hang size="big" href={sitePath('/')}>Back to the start</ObjLink>
      <ObjLink hang href={appLink(siteShot('void-bootes').link)}>Or go and see the void</ObjLink>
      <ShotCaption id="void-bootes" open={false} />
      <Sources ids={['bootes-void']} />
    </div>
  </section>
</Base>

<style>
  .lost {
    position: relative;
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--nav-height));
    overflow-x: clip;
    background: #000;
  }

  /* Wide: the picture runs off the right edge, which puts the void's ring beside the words, not under them. */
  .back {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .back :global(img) {
    display: block;
    width: 145%;
    max-width: none;
    height: 100%;
    object-fit: cover;
  }

  .back::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.8) 0%, rgb(0 0 0 / 0) 55%);
  }

  /* A column, so the picture's label can leave the words for the picture's foot, as in a PictureBand. */
  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-self: stretch;
    width: 100%;
    padding-block: 4rem 2rem;
  }

  .copy > :global(:first-child) {
    margin-top: auto;
  }

  h1 {
    font-size: var(--text-h2);
  }

  .say {
    max-width: 30rem;
    font-size: var(--text-lead);
  }

  .copy :global(.ring) {
    display: flex;
    width: fit-content;
  }

  .copy > :global(.caption) {
    --caption-foot: '';
    order: 1;
    margin-top: auto;
    padding-top: 4rem;
  }

  /* Narrow: the ring above, the words under it. */
  @media (max-width: 900px) {
    .lost {
      align-items: start;
    }

    .back {
      bottom: auto;
      height: 46svh;
    }

    .back :global(img) {
      width: 100%;
    }

    .back::after {
      background: linear-gradient(180deg, rgb(0 0 0 / 0) 60%, #000 100%);
    }

    .copy {
      padding-block: 40svh 3rem;
    }

    .copy > :global(:first-child) {
      margin-top: 0;
    }

    .copy > :global(.caption) {
      --caption-foot: none;
      order: -1;
      margin-bottom: 2rem;
      padding-top: 0;
    }
  }
</style>
