---
import Base from '../layouts/Base.astro';
import ObjLink from '../components/ObjLink.astro';
import PictureBand from '../components/PictureBand.astro';
import ShotCaption from '../components/ShotCaption.astro';
import Sources from '../components/Sources.astro';
import { appLink } from '../data/appLink';
import { siteShot } from '../data/siteShot';
import { sitePath } from '../utils/sitePath';
---

<Base title="Page not found: skymap" description="This address is not on the map. The way back to skymap starts here.">
  <!-- The void's ring is in the middle of the frame: zoomed, it stands beside the words, not under them. -->
  <PictureBand id="void-bootes" gap="none" zoom={1.45} eager>
    <h1>There is nothing here</h1>
    <p class="say">
      This address is not on the map. The picture is the Boötes Void, found in 1981 and described as a
      million cubic megaparsecs of very little. You are in suitable company.
    </p>
    <ObjLink hang size="big" href={sitePath('/')}>Back to the start</ObjLink>
    <ObjLink hang href={appLink(siteShot('void-bootes').link)}>Or go and see the void</ObjLink>
    <ShotCaption id="void-bootes" open={false} />
  </PictureBand>
  <div class="wrap section last">
    <Sources ids={['bootes-void']} />
  </div>
</Base>
