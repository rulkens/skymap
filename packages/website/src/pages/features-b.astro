---
/* A comparison route for the Features page (components/FeatureStage.astro); the chosen variant becomes /features/. */
import Base from '../layouts/Base.astro';
import FeatureStage from '../components/FeatureStage.astro';

const title = 'Features, with an index and a stage | skymap';
const description =
  'Everything you can see and do in skymap, group by group, each with a link to its page in the docs.';
---

<Base title={title} description={description}>
  <FeatureStage />
</Base>
