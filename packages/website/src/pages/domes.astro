---
/* The domes page: its text and front matter are content/pages/domes/domes.mdx, which places the contact section. */
import { getEntry, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import { breadcrumbJsonLd } from '../utils/breadcrumbJsonLd';

const entry = (await getEntry('pages', 'domes'))!;
const { Content } = await render(entry);
---

<Base {...entry.data} jsonLd={[breadcrumbJsonLd(Astro.site!, [{ name: 'Domes and museums', path: '/domes/' }])]}>
  <Content />
</Base>
