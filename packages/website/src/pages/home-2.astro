---
/*
 * The redesigned Home, beside today's for the owner to compare: its text is content/pages/home-2/home-2.mdx.
 * Out of the nav and the footer. The head is the home route's (pages/index.astro): the same flight, so the same
 * preloads, pre-paint script and stills. No JSON-LD: the site's one WebSite record stays on the root page.
 */
import { getEntry, render } from 'astro:content';

import { flightStopViews } from '../components/pages/home/Flight/flightStopViews.ts';
import { prePaintScript } from '../components/pages/home/Flight/prePaintScript.ts';
import { FLIGHT_STOPS } from '../data/flightStops';
import Base from '../layouts/Base.astro';
import { flightStills } from '../utils/flightStills';
import { heroVideoUrl } from '../utils/heroVideoUrl';

const entry = (await getEntry('pages', 'home-2'))!;
const { Content } = await render(entry);
const structure = (await getEntry('pageStructures', 'home-2'))!.data;
const stills = await flightStills(FLIGHT_STOPS.map((stop) => stop.id));
const first = stills[0]!;
---

<Base {...entry.data} {...structure} heroNav>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" media="(orientation: portrait)" imagesrcset={first.portrait.avif} imagesizes={first.portrait.sizes} fetchpriority="high" />
    <link rel="preload" as="image" type="image/avif" media="(orientation: landscape)" imagesrcset={first.landscape.avif} imagesizes={first.landscape.sizes} fetchpriority="high" />
    <script is:inline set:html={prePaintScript()} />
  </Fragment>
  <Content stops={flightStopViews(stills)} videoUrl={heroVideoUrl()} />
</Base>
