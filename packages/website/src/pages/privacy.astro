---
import Base from '../layouts/Base.astro';
import Caveat from '../components/Caveat.astro';
import Claims from '../components/Claims.astro';
import Group from '../components/Group.astro';
import LinkRow from '../components/LinkRow.astro';
import Note from '../components/Note.astro';
import ObjLink from '../components/ObjLink.astro';
import PictureBand from '../components/PictureBand.astro';
import Prose from '../components/Prose.astro';
import Remark from '../components/Remark.astro';
import SectionHead from '../components/SectionHead.astro';
import ShotCaption from '../components/ShotCaption.astro';
import Sources from '../components/Sources.astro';
import { OPEN_APP_LABEL } from '../data/appLink';
import { CONTACT_ENDPOINT, ISSUES_URL } from '../data/contact';
import { fact } from '../data/fact';
import { MAKER_NAME } from '../data/siteIdentity';
import { breadcrumbJsonLd } from '../utils/breadcrumbJsonLd';
import { formatDate } from '../utils/formatDate';
import { sitePath } from '../utils/sitePath';

const title = 'Privacy: what skymap loads, counts and keeps';
const description =
  'This website sets no cookies and counts nothing. The app counts visits without cookies and keeps one note in your browser. Each claim names its source.';

const SITE = [
  { term: 'What it loads', id: 'privacy-site-requests' },
  { term: 'Who serves it', id: 'privacy-host' },
  { term: 'What the host sees', id: 'privacy-host-sees' },
];
const COUNTER = [
  { term: 'The counter', id: 'privacy-counter' },
  { term: 'What it sends', id: 'privacy-counter-sends' },
  { term: 'What is stored', id: 'privacy-counter-stores' },
  { term: 'No cookie', id: 'privacy-counter-cache' },
  { term: 'How long', id: 'privacy-counter-retention' },
  { term: 'No notice', id: 'privacy-no-notice' },
];
const APP = [
  { term: 'In your browser', id: 'privacy-app-storage' },
  { term: 'Galaxy pictures', id: 'privacy-thumbnails' },
];
// Every fact row the page prints, so the Sources list cannot drift from the copy.
const factIds = [...SITE, ...COUNTER, ...APP].map((item) => item.id).concat('privacy-form-closed');
const checked = formatDate(fact('privacy-site-requests').checked);
---

<Base
  title={title}
  description={description}
  jsonLd={[breadcrumbJsonLd(Astro.site!, [{ name: 'Privacy', path: '/privacy/' }])]}
>
  <PictureBand id="privacy-far-side" gap="none" eager>
    <h1>Privacy</h1>
    <p class="say">
      This website collects nothing about you. The app counts visits without cookies and keeps one note in your
      browser.
    </p>
    <Note flow>Each statement below was read from the code on <span class="date">{checked}</span>.</Note>
    <ShotCaption id="privacy-far-side" />
  </PictureBand>

  <section class="wrap section" id="website">
    <SectionHead title="This website" narrow>
      <p>The pages you are reading now: the home page, the pages for classrooms, domes and science, the about page and this one.</p>
    </SectionHead>
    <Claims items={SITE} />
    <Remark text="Your browser fetched every file on this page from skymap’s own addresses." live="files-fetched" />
  </section>

  <section class="wrap section" id="app">
    <SectionHead title="The app" narrow>
      <p>The map itself, which opens when you choose “{OPEN_APP_LABEL}”. It does more than the pages do, so there is more to say.</p>
    </SectionHead>
    <Group title="The visit counter">
      <Claims items={COUNTER} />
    </Group>
    <Caveat title="Where this falls short">
      <p>
        The counter starts without asking you, and the app does not mention it. We have not set a limit of our own on
        how long its rows are kept, so treat them as kept with no fixed end date until this page says otherwise.
      </p>
      <p>
        A content blocker that stops requests to <span class="host">counterscale.rulkens.workers.dev</span> stops the
        counter. The app works the same without it.
      </p>
    </Caveat>
    <Group title="Everything else">
      <Claims items={APP} />
    </Group>
    <Note>
      The app’s data files come from the same host as this website, described above. Links in the app to outside
      catalogues, such as NED and Aladin, open those sites only when you choose them.
    </Note>
  </section>

  <section class="wrap section" id="form">
    <SectionHead title="The contact form" narrow>
      <p>{CONTACT_ENDPOINT ? 'The form on the domes page is open.' : fact('privacy-form-closed').text}</p>
    </SectionHead>
    {
      !CONTACT_ENDPOINT && (
        <Prose>
          <p>
            Until it opens, the way to reach us is the <a href={ISSUES_URL}>issue list on GitHub</a>. An issue is
            public, it carries your GitHub name, and GitHub’s own privacy statement applies to it.
          </p>
        </Prose>
      )
    }
    <Caveat title={CONTACT_ENDPOINT ? 'What happens to a message' : 'The plan, not yet in effect'}>
      <p>
        {CONTACT_ENDPOINT ? 'When you send the form' : 'When the form opens'}, your message will go to a small program
        of ours on Cloudflare, which forwards the four fields (name, organisation, email address and message) to us as
        an email. A spam check, Cloudflare Turnstile, will run before a message is accepted. Your browser will load
        its script from challenges.cloudflare.com, on the domes page only, and only when the form comes into view. The program keeps
        nothing of its own. We will keep the email for as long as the conversation needs it.
      </p>
      <Note flow>
        This paragraph describes a design, not a running system. We will rewrite this section when the form opens,
        and the date at the top of the page will change with it.
      </Note>
    </Caveat>
  </section>

  <section class="wrap section" id="responsible">
    <SectionHead title="Who is responsible" narrow>
      <p>
        {MAKER_NAME}, who makes skymap, decides what the site and the app load and keep.
      </p>
    </SectionHead>
    <Prose>
      <p>
        To ask what we hold about you, or to have it removed, open an issue on GitHub that says only that you have
        a privacy request, and we will reply with an address. Today the answer is short: the counter’s rows carry no name, no IP address and no identifier, so we cannot find yours among them.
      </p>
    </Prose>
    <LinkRow>
      <ObjLink hang size="small" href={ISSUES_URL}>The issue list on GitHub</ObjLink>
      <ObjLink hang size="small" href={sitePath('/about/')}>About skymap</ObjLink>
    </LinkRow>
  </section>

  <div class="wrap section last">
    <Sources ids={factIds} all />
  </div>
</Base>

<style>
  /* An address inside a sentence: it may break anywhere, or it pushes a phone's page sideways. */
  .host {
    overflow-wrap: anywhere;
    color: var(--color-fg);
  }
</style>
