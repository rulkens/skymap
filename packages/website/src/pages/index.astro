---
import Base from '../layouts/Base.astro';
import Classroom from '../components/Classroom/Classroom.tsx';
import Closing from '../components/Closing/Closing.tsx';
import Credits from '../components/Credits/Credits.tsx';
import Dome from '../components/Dome/Dome.tsx';
import Flight from '../components/Flight/Flight.tsx';
import { prePaintScript } from '../components/Flight/prePaintScript.ts';
import FullFigure from '../components/FullFigure/FullFigure.tsx';
import Honesty from '../components/Honesty/Honesty.tsx';
import Lead from '../components/Lead/Lead.tsx';
import Places from '../components/Places/Places.tsx';
import Tour from '../components/Tour/Tour.tsx';
import { FLIGHT_STOPS } from '../data/flightStops';
import { homeJsonLd } from '../data/homeJsonLd';
import layout from '../styles/layout.module.css';
import { flightStills } from '../utils/flightStills';
import { heroVideoUrl } from '../utils/heroVideoUrl';

const title = 'Skymap: the mapped universe at true scale, in your browser';
const description =
  'Fly from a Copenhagen park to the cosmic web in one continuous scene built from star and galaxy catalogues. Free, no account, in a current browser.';
const stills = await flightStills(FLIGHT_STOPS.map((stop) => stop.id));
const first = stills[0]!;

---

<Base title={title} description={description} jsonLd={homeJsonLd(Astro.site!, description)} heroNav>
  <!-- The first still is the largest paint on a phone; the same srcsets feed the <picture>, so it is fetched once. -->
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" media="(orientation: portrait)" imagesrcset={first.portrait.avif} imagesizes={first.portrait.sizes} fetchpriority="high" />
    <link rel="preload" as="image" type="image/avif" media="(orientation: landscape)" imagesrcset={first.landscape.avif} imagesizes={first.landscape.sizes} fetchpriority="high" />
    <!-- Before first paint, so the flight's layout is decided once; the island takes over from it. -->
    <script is:inline set:html={prePaintScript()} />
  </Fragment>
  <Flight stills={stills} videoUrl={heroVideoUrl()} client:load />
  <Places client:visible />
  <Lead client:visible />
  <FullFigure id="hubble" tall="hubble-portrait" />
  <Tour />
  <Classroom />
  <Dome />
  <Honesty />
  <Closing />
  <div class={`${layout.wrap} ${layout.section}`}>
    <Credits />
  </div>
</Base>
