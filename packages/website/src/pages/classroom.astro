---
import Base from '../layouts/Base.astro';
import AddressStrip from '../components/AddressStrip.astro';
import Credits from '../components/Credits.astro';
import LessonLinks from '../components/LessonLinks.astro';
import ObjLink from '../components/ObjLink.astro';
import PictureBand from '../components/PictureBand.astro';
import Shot from '../components/Shot.astro';
import ShotCaption from '../components/ShotCaption.astro';
import Sources from '../components/Sources.astro';
import { appLink } from '../data/appLink';
import { fact } from '../data/fact';
import { HOME_LINKS } from '../data/homeLinks';
import { HONESTY } from '../data/honesty';
import { LESSON_TOPICS } from '../data/lessons';
import { breadcrumbJsonLd } from '../utils/breadcrumbJsonLd';
import { sitePath } from '../utils/sitePath';

const title = 'Teach with skymap: lesson links for astronomy | skymap';
const description =
  'A lesson link opens the same view of the mapped universe for every pupil. No accounts, nothing to install. Ready-made links by topic, and how to make your own.';

// Every fact row the page prints, so the Sources list cannot drift from the copy.
const said = [
  'lesson-link',
  'no-account',
  'link-pose',
  'webgpu-required',
  'webgpu-browsers',
  'app-browser-advice',
  'phone-data-size',
  'english-only',
];
const factIds = [...said, ...LESSON_TOPICS.flatMap((t) => t.lessons.flatMap((l) => (l.factId ? [l.factId] : [])))];
const lessonCount = LESSON_TOPICS.reduce((n, t) => n + t.lessons.length, 0);
---

<Base
  title={title}
  description={description}
  jsonLd={[breadcrumbJsonLd(Astro.site!, [{ name: 'Classrooms', path: '/classroom/' }])]}
>
  <PictureBand id="classroom-hero" tall="classroom-hero-portrait" gap="none" eager>
    <h1>Use skymap in a classroom</h1>
    <p class="say">
      A lesson link is a web address that opens skymap on one object at one date. Every pupil who opens it lands in
      the same place. This one is Jupiter on 14 March 2033.
    </p>
    <AddressStrip hash={HOME_LINKS.classroom} />
    <ShotCaption id="classroom-hero" />
  </PictureBand>

  <section class="wrap section prose" id="why">
    <h2>Why a link suits a class</h2>
    <div class="cols">
      <div>
        <h3>One view for everyone</h3>
        <p>{fact('lesson-link').text}</p>
        <p>
          So a link with a date in it opens on that date for everyone, including the pupil who arrives late. From
          there each pupil can turn, zoom and fly on their own.
        </p>
      </div>
      <div>
        <h3>Nothing to set up</h3>
        <p>It is a web page: there is nothing to install. {fact('no-account').text}</p>
      </div>
      <div>
        <h3>What it runs on</h3>
        <p>{fact('webgpu-required').text}</p>
        <p>{fact('webgpu-browsers').text}</p>
        <p>
          {fact('app-browser-advice').text} Open one link on a pupil’s device before the lesson: school networks and
          older graphics chips differ.
        </p>
        <ObjLink size="small" href={sitePath('/docs/start/browsers/')}>Browser support and troubleshooting</ObjLink>
      </div>
    </div>
  </section>

  <section class="wrap section" id="links">
    <div class="head">
      <h2>Ready-made links</h2>
      <p>
        {lessonCount} links in {LESSON_TOPICS.length} topics. Each opens exactly where its picture was taken. The
        pictures have the name labels switched off; the links open with them on.
      </p>
    </div>
    <LessonLinks />
  </section>

  <section class="wrap section" id="make">
    <div class="head">
      <h2>Make your own link</h2>
      <p>Three steps, in the app itself. There is no share button: the address bar is the link.</p>
    </div>
    <ol class="steps">
      <li>
        <figure>
          <Shot id="make-search" sizes="(max-width: 900px) 60vw, 36rem" />
          <figcaption><ShotCaption id="make-search" /></figcaption>
        </figure>
        <div>
          <h3>Find the object</h3>
          <p>
            Open the search with the <kbd>/</kbd> key or the search field at the top, type a name and press Enter. The
            camera flies there. A double-click on anything in the scene does the same.
          </p>
        </div>
      </li>
      <li>
        <figure>
          <Shot id="make-date" sizes="(max-width: 900px) 60vw, 36rem" />
          <figcaption><ShotCaption id="make-date" /></figcaption>
        </figure>
        <div>
          <h3>Set the date</h3>
          <p>
            Select the clock at the bottom right, type a date and time in UTC, and press Enter. The clock stops at
            that instant and the planets and moons move to where they were, or will be.
          </p>
        </div>
      </li>
      <li>
        <div class="address">
          <AddressStrip hash={HOME_LINKS.classroom} />
        </div>
        <div>
          <h3>Copy the address</h3>
          <p>
            The address bar now names the object and the instant. Copy it into your lesson plan, a slide or the class
            chat. {fact('link-pose').text}
          </p>
          <ObjLink size="small" href={sitePath('/docs/guide/sharing/')}>Sharing a view, in the docs</ObjLink>
        </div>
      </li>
    </ol>
  </section>

  <section class="wrap section" id="accuracy">
    <div class="head">
      <h2>What you can teach from, and what is drawn</h2>
      <p>
        Some of the scene is data and some is a model or a choice of ours. A class can check each line: every one
        links to its source.
      </p>
    </div>
    <div class="cols two">
      <div>
        <h3>Accurate enough to teach from</h3>
        <ul class="small">
          {[...HONESTY.measured, ...HONESTY.derived].map((item) => <li><a href={item.href}>{item.text}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>Drawn or simplified: say so in class</h3>
        <ul class="small">
          {HONESTY.drawn.map((item) => <li><a href={item.href}>{item.text}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="onward">
      <ObjLink href={sitePath('/science/')}>The science behind skymap</ObjLink>
      <ObjLink href={sitePath('/docs/simplifications/')}>Known simplifications</ObjLink>
    </div>
  </section>

  <section class="wrap section prose" id="limits">
    <h2>Limits worth knowing before the lesson</h2>
    <ul class="limits">
      <li>{fact('english-only').text}</li>
      <li>{fact('phone-data-size').text}</li>
      <li>
        A link pins the camera against the stars, not to a spot on the ground. It cannot show the Moon’s phases as
        they look from Earth, so there is no ready-made link for phases or eclipses.
      </li>
    </ul>
    <div class="onward">
      <ObjLink href={appLink()}>Fly it yourself</ObjLink>
      <ObjLink href={sitePath('/domes/')}>For a dome or a museum</ObjLink>
      <ObjLink href={sitePath('/')}>Back to the start</ObjLink>
    </div>
  </section>

  <div class="wrap section last">
    <Sources ids={factIds} label="Sources for the claims on this page" />
    <Credits />
  </div>
</Base>

<style>
  h1 {
    max-width: 12ch;
    font-size: var(--text-h2);
  }

  .say {
    max-width: 30rem;
    font-size: var(--text-lead);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-bottom: 2.5rem;
  }

  .head h2,
  .head p {
    margin: 0;
  }

  .head h2 {
    max-width: 16ch;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem 3.75rem;
    margin-top: 2.5rem;
  }

  .cols.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 0;
  }

  .cols p {
    font-size: var(--text-small);
    font-weight: var(--weight-small);
    line-height: 1.5;
  }

  .cols ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cols li a {
    display: block;
    padding-block: 0.5rem;
    color: var(--site-text-muted);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 1.5rem 3.75rem;
    align-items: center;
    padding-block: 2.5rem;
    border-top: 1px solid var(--border-divider);
    counter-increment: step;
  }

  .steps h3 {
    font-size: var(--text-lead);
  }

  .steps h3::before {
    content: counter(step) '. ';
    color: var(--site-text-dim);
  }

  .steps figure {
    margin: 0;
  }

  .steps figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .steps figcaption {
    margin-top: 0.5rem;
  }

  .steps .address {
    min-width: 0;
  }

  kbd {
    padding: 0 0.35em;
    border: 1px solid rgb(232 238 255 / 0.28);
    border-radius: 0.2rem;
    font: 400 0.875em var(--font-family-mono);
  }

  .limits {
    max-width: 44rem;
    margin: 0 0 2rem;
    padding-left: 1.25rem;
    color: var(--site-text-muted);
  }

  .limits li {
    padding-block: 0.4rem;
  }

  .onward {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2.5rem;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .cols,
    .cols.two,
    .steps li {
      grid-template-columns: 1fr;
    }

    .steps li {
      padding-block: 2rem;
    }
  }
</style>
