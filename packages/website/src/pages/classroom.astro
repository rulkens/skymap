---
/* The classroom page: its text and front matter are content/pages/classroom.mdx. */
import { getEntry, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import { breadcrumbJsonLd } from '../utils/breadcrumbJsonLd';

const entry = (await getEntry('pages', 'classroom'))!;
const { Content } = await render(entry);
---

<Base {...entry.data} jsonLd={[breadcrumbJsonLd(Astro.site!, [{ name: 'Classrooms', path: '/classroom/' }])]}>
  <Content />
</Base>
