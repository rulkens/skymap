---
import Base from '../layouts/Base.astro';
import AskList from '../components/AskList/AskList.tsx';
import Citation from '../components/Citation/Citation.tsx';
import Claims from '../components/Claims/Claims.tsx';
import Columns from '../components/Columns/Columns.tsx';
import Credits from '../components/Credits/Credits.tsx';
import FramePair from '../components/FramePair/FramePair.tsx';
import FullFigure from '../components/FullFigure/FullFigure.tsx';
import Group from '../components/Group/Group.tsx';
import Note from '../components/Note/Note.tsx';
import ObjLink from '../components/ObjLink/ObjLink.tsx';
import OpenApp from '../components/OpenApp/OpenApp.tsx';
import PictureBand from '../components/PictureBand/PictureBand.tsx';
import Remark from '../components/Remark/Remark.tsx';
import SectionHead from '../components/SectionHead/SectionHead.tsx';
import SectionNav from '../components/SectionNav/SectionNav.tsx';
import ShotCaption from '../components/ShotCaption/ShotCaption.tsx';
import StatementsFigure from '../components/StatementsFigure/StatementsFigure.tsx';
import Sources from '../components/Sources/Sources.tsx';
import SourceTable from '../components/SourceTable/SourceTable.tsx';
import { fact } from '../data/fact';
import { REPO_URL } from '../data/siteIdentity';
import layout from '../styles/layout.module.css';
import links from '../styles/links.module.css';
import { breadcrumbJsonLd } from '../utils/breadcrumbJsonLd';
import { formatDate } from '../utils/formatDate';
import { sitePath } from '../utils/sitePath';

const section = `${layout.wrap} ${layout.section}`;
const linkRow = `${links['link-row']} ${links.onward}`;

const title = 'The science behind Skymap: data, methods, limits';
const description =
  'Where Skymap’s numbers come from, how we turn catalogues into pixels, and where we simplify. Each claim links to its source.';

const MEASURED = [
  { term: 'Directions', id: 'sci-directions' },
  { term: 'Redshifts', id: 'sci-redshifts' },
  { term: 'Stars', id: 'sci-star-observables' },
  { term: 'Galaxy brightness', id: 'sci-magnitudes' },
  { term: 'Surfaces', id: 'sci-surfaces' },
];
const DERIVED = [
  { term: 'Galaxy distances', id: 'sci-galaxy-distance' },
  { term: 'The Hubble constant', id: 'sci-h0-range' },
  { term: 'Nearby galaxies', id: 'sci-local-volume' },
  { term: 'Two kinds of redshift', id: 'sci-two-redshifts' },
  { term: 'Star distances', id: 'sci-star-distance' },
  { term: 'Planets and moons', id: 'sci-ephemeris' },
  { term: 'Density field', id: 'sci-density-field' },
  { term: 'Filaments', id: 'sci-filaments' },
  { term: 'Flows', id: 'sci-flows' },
  { term: 'Galaxy colour', id: 'sci-colour' },
  { term: 'Clusters', id: 'sci-structures' },
];
const DRAWN = [
  { term: 'The Milky Way', id: 'sci-milky-way' },
  { term: 'Its stars', id: 'sci-milky-way-points' },
  { term: 'The edge sphere', id: 'sci-horizon-shell' },
  { term: 'How far the data go', id: 'sci-deepest' },
  { term: 'Planet maps', id: 'sci-planet-maps' },
  { term: 'Atmospheres', id: 'sci-atmospheres' },
  { term: 'Earth’s clouds', id: 'sci-earth-clouds' },
  { term: 'Galaxy discs', id: 'sci-galaxy-discs' },
  { term: 'Galaxy tilt', id: 'sci-galaxy-tilt' },
  { term: 'DESI brightness', id: 'sci-desi-brightness' },
  { term: 'The black hole', id: 'sci-black-hole' },
  { term: 'Zone of Avoidance band', id: 'sci-zoa-band' },
  { term: 'Structure markers', id: 'sci-markers' },
  { term: 'Glow and tone', id: 'sci-tone' },
];
const SIMPLIFIED = [
  {
    title: 'Distance',
    items: [
      { term: 'Redshift space', id: 'sim-redshift-space' },
      { term: 'Reference frame', id: 'sim-frames' },
      { term: 'Two expansion rates', id: 'sim-horizon-h0' },
      { term: 'A step at 30 megaparsecs', id: 'sim-scale-step' },
      { term: 'Estimated redshifts', id: 'sci-photometric-share' },
    ],
  },
  {
    title: 'Coverage',
    items: [
      { term: 'SDSS footprint', id: 'survey-gaps' },
      { term: '2MRS footprint', id: '2mrs-coverage' },
      { term: 'Zone of Avoidance', id: 'sim-zone' },
      { term: 'DESI', id: 'sim-desi-patches' },
      { term: 'Flux limits', id: 'sim-flux-limits' },
      { term: 'Our own dimming', id: 'sim-reweight' },
      { term: 'Data sizes', id: 'sim-data-sizes' },
      { term: 'Duplicates', id: 'sim-duplicates' },
    ],
  },
  {
    title: 'Stars, planets and time',
    items: [
      { term: 'Stars stand still', id: 'sim-star-epoch' },
      { term: 'Which stars', id: 'sim-star-coverage' },
      { term: 'Outside 1900 to 2100', id: 'sim-ephemeris-span' },
    ],
  },
  {
    title: 'Size and brightness',
    items: [
      { term: 'Exposure', id: 'sim-exposure' },
      { term: 'Quasars', id: 'sim-quasar-boost' },
      { term: 'Galaxy points', id: 'sim-point-floor' },
      { term: 'Planets and stars', id: 'sim-true-size' },
    ],
  },
];

// Every fact row the page prints, so the Sources list cannot drift from the copy.
const factIds = [
  ...[...MEASURED, ...DERIVED, ...DRAWN, ...SIMPLIFIED.flatMap((group) => group.items)].map((item) => item.id),
  'sci-built-counts',
  'sci-cite-skymap',
  'astronomical-unit',
  'megaparsec-length',
];
const count = SIMPLIFIED.reduce((n, group) => n + group.items.length, 0);
---

<Base
  title={title}
  description={description}
  jsonLd={[breadcrumbJsonLd(Astro.site!, [{ name: 'Science', path: '/science/' }])]}
>
  <PictureBand id="science-wedges" gap="none" eager>
    <h1>The science behind Skymap</h1>
    <p class="say">
      Skymap places catalogued stars, galaxies and quasars in three dimensions. This page names the sources, says
      what is measured, what is derived and what is drawn, and lists where we simplify.
    </p>
    <ShotCaption id="science-wedges" />
  </PictureBand>

  <SectionNav
    items={[
      { href: '#sources', label: 'The sources', icon: 'sources' },
      {
        href: '#bins',
        label: 'Measured, derived, drawn',
        icon: 'method',
      },
      {
        href: '#simplifications',
        label: 'Known simplifications',
        icon: 'simplified',
      },
      { href: '#cite', label: 'How to cite', icon: 'cite' },
    ]}
  />

  <section class={section} id="sources">
    <SectionHead title="The sources">
      <p>
        This is every dataset Skymap is built from: the catalogues of stars and galaxies, the orbits, the named structures and
        the imagery. We list them so that anything you see in the app can be traced to who measured it. Each name opens a page
        with its licence and the files we use.
      </p>
    </SectionHead>
    <SourceTable>
      <p>
        {fact('sci-built-counts').text}{' '}
        <a href={fact('sci-built-counts').source}>{fact('sci-built-counts').sourceLabel}</a>
      </p>
      <p>
        The count is what the app draws. It is smaller than the source’s own total because rows without a usable
        <a href={sitePath('/docs/reference/glossary/#redshift')}>redshift</a> are dropped, <a href={sitePath('/docs/data/pipeline/#cross-match-and-de-duplicate')}>overlapping catalogues are merged</a>, and <a href={sitePath('/docs/data/sdss/')}>SDSS</a> is cut to about 500,000 of its most
        luminous galaxies. Where a count is missing, neither our build nor the source’s own record gives one.
      </p>
      <p>
        Terrain heights, the Mars rover sites, 3D models, the constellation lines, the photographs of named galaxies
        and the survey pictures fetched for other galaxies are not in the table. They are recorded in the
        repository’s <a href={`${REPO_URL}/tree/main/data/raw`}>data records</a> and its{' '}
        <a href={`${REPO_URL}/blob/main/ATTRIBUTIONS.md`}>attributions file</a>.
      </p>
    </SourceTable>
  </section>

  <section class={section} id="bins">
    <SectionHead title="Measured, derived, drawn">
      <p>
        Each word has one meaning on this site. A point in the scene is usually all three at once: a measured
        direction, a <a href={sitePath('/docs/science/#distance-from-redshift')}>derived distance</a> and a drawn dot.
      </p>
    </SectionHead>

    <Group title="Measured" big first>
      <p slot="lede">An instrument recorded it, and we use the published value.</p>
      <Claims items={MEASURED} />
    </Group>

    <Group title="Derived" big>
      <p slot="lede">Computed from measurements by a method we can name.</p>
      <FramePair start="science-web-points" end="science-web-density" sizes="(max-width: 900px) 100vw, 36rem" />
      <Claims items={DERIVED} />
    </Group>

    <Group title="Drawn" big>
      <p slot="lede">
        A model or a choice of ours, with no measurement behind each object. Every camera we have is still inside the
        <a href={sitePath('/docs/science/#the-milky-way')}>Milky Way</a>, so its portrait from outside has to be drawn.
      </p>
      <StatementsFigure id="milky-way-drawn" sizes="(max-width: 900px) 100vw, 40rem" />
      <Claims items={DRAWN} />
    </Group>
    <Remark client:visible text={fact('astronomical-unit').short!} />
  </section>

  <FullFigure id="science-zoa" />

  <section class={section} id="simplifications">
    <SectionHead title="Known simplifications">
      <p>
        {count} places where the scene <a href={sitePath('/docs/simplifications/')}>departs from the sky</a>, or from what a careful analysis would do, as of{' '}
        {formatDate(fact('sim-frames').checked)}.
      </p>
    </SectionHead>
    {
      SIMPLIFIED.map((group, i) => (
        <Group title={group.title} big first={i === 0}>
          <Claims items={group.items} />
        </Group>
      ))
    }
    <Note>
      If you find one we missed, <a href={`${REPO_URL}/issues`}>open an issue in the repository</a>.
    </Note>
  </section>

  <section class={section} id="cite">
    <SectionHead title="How to cite">
      <p><a href={sitePath('/docs/cite/')}>Cite Skymap</a> for the pictures, and the catalogues for the data in them.</p>
    </SectionHead>
    <Columns count={2}>
      <div>
        <h3>skymap</h3>
        <Citation />
      </div>
      <div>
        <h3>The catalogues</h3>
        <AskList />
      </div>
    </Columns>
  </section>

  <section class={section} id="onward">
    <h2>Further reading</h2>
    <div class={links['link-row']}>
      <ObjLink hang href={sitePath('/docs/data/')}>Data sources, one page each</ObjLink>
      <ObjLink hang href={sitePath('/docs/science/')}>The methods in full</ObjLink>
      <ObjLink hang href={sitePath('/docs/simplifications/')}>Known simplifications, in full</ObjLink>
      <ObjLink hang href={sitePath('/docs/cite/')}>Cite Skymap</ObjLink>
      <ObjLink hang href={sitePath('/classroom/')}>Use Skymap in the classroom</ObjLink>
      <ObjLink hang href={sitePath('/domes/')}>Domes and museums</ObjLink>
    </div>
    <div class={linkRow}>
      <OpenApp />
    </div>
  </section>

  <div class={section}>
    <Sources ids={factIds} />
    <Credits />
  </div>
</Base>
