---
/* The science page: its text and front matter are content/pages/science.mdx. */
import { getEntry, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import { breadcrumbJsonLd } from '../utils/breadcrumbJsonLd';

const entry = (await getEntry('pages', 'science'))!;
const { Content } = await render(entry);
---

<Base {...entry.data} jsonLd={[breadcrumbJsonLd(Astro.site!, [{ name: 'Science', path: '/science/' }])]}>
  <Content />
</Base>
