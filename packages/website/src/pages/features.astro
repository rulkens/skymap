---
/* The Features page: its groups, pictures and films are in components/FeatureStage.astro. */
import Base from '../layouts/Base.astro';
import FeatureStage from '../components/FeatureStage.astro';

const title = 'Features | Skymap';
const description =
  'Everything you can see and do in Skymap, group by group, each with a link to its page in the docs.';
---

