---
/* The Features page: its groups, pictures and films are in components/FeatureStage/FeatureStage.tsx. */
import Base from '../layouts/Base.astro';
import FeatureLead from '../components/FeatureLead/FeatureLead.tsx';
import FeatureStage from '../components/FeatureStage/FeatureStage.tsx';

const title = 'Features | Skymap';
const description =
  'Everything you can see and do in Skymap, group by group, each with a link to its page in the docs.';
---

<Base title={title} description={description}>
  <FeatureLead />
  <FeatureStage client:load />
</Base>
