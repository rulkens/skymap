---
/* The Features page: its text and front matter are content/pages/features.mdx. */
import { getEntry, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import { breadcrumbJsonLd } from '../utils/breadcrumbJsonLd';

const entry = (await getEntry('pages', 'features'))!;
const { Content } = await render(entry);
---

<Base {...entry.data} jsonLd={[breadcrumbJsonLd(Astro.site!, [{ name: 'Features', path: '/features/' }])]}>
  <Content />
</Base>
