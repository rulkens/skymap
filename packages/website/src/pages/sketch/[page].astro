---
/*
 * The design sketch of a landing page, dev only: its structure file drawn section by section
 * (SketchSection), so saving `<page>.structure.yaml` redraws it. A section naming a `component` from
 * LIVE is drawn by the real component instead, for the sections that stay as they are. The build makes
 * no sketch pages.
 */
import { getCollection } from 'astro:content';

import Places from '../../components/pages/home/Places/Places.tsx';
import { placeLines } from '../../components/pages/home/Places/placeLines.ts';
import Section from '../../components/shared/layout/Section/Section.tsx';
import Credits from '../../components/shared/text/Credits/Credits.tsx';
import ShotIndex from '../../dev/sketch/ShotIndex/ShotIndex.tsx';
import SketchSection from '../../dev/sketch/SketchSection/SketchSection.tsx';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const structures = await getCollection('pageStructures');
  return structures.map((entry) => ({ params: { page: entry.id }, props: { structure: entry.data } }));
}

const { structure } = Astro.props;
const { page } = Astro.params;
---

<Base title={`Sketch: ${page}`} description={structure.job} job={structure.job}>
  <Section as="div">
    <p>Sketch of <strong>{page}</strong>, drawn from <code>content/pages/{page}/{page}.structure.yaml</code>. Save the file to redraw.</p>
    <h1>{structure.job}</h1>
  </Section>
  {
    structure.sections.map((section) =>
      section.component === 'Places' ? (
        <Places lines={placeLines()} client:visible />
      ) : section.component === 'Credits' ? (
        <Section as="div">
          <Credits />
        </Section>
      ) : (
        <Section>
          <SketchSection section={section} />
        </Section>
      ),
    )
  }
  <Section as="div">
    <ShotIndex />
  </Section>
</Base>
