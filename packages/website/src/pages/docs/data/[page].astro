---
/*
 * One data page for each row of data/dataPages.ts: a single source, or a
 * family of small entries (code, fonts, services) that share a page, each
 * under a heading whose anchor is its entry id. Nothing on these pages is
 * written here but the sentences that join the record's parts.
 */
import DataEntryRecord from '../../../components/DataEntryRecord.astro';
import DocLink from '../../../components/DocLink.astro';
import RecordText from '../../../components/RecordText.astro';
import Recorded from '../../../components/Recorded.astro';
import { DATA_PAGES } from '../../../data/dataPages';
import { DATA_SOURCE_NOTES } from '../../../data/dataSourceNotes';
import { REPO_BLOB } from '../../../data/siteIdentity';
import Docs from '../../../layouts/Docs.astro';
import { plainText } from '../../../utils/plainText';

export function getStaticPaths() {
  return DATA_PAGES.map((page) => ({ params: { page: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const shared = page.family.pages === 'one';
const notes = [...new Set(page.entries.flatMap((entry) => entry.record.notes))];
const checked = page.entries.map((entry) => entry.checked).sort().at(-1)!;
const headings = shared
  ? page.entries.map((entry) => ({ depth: 2, slug: entry.id, text: plainText(entry.record.heading) }))
  : [
      { depth: 2, slug: 'licence', text: 'Licence and terms' },
      { depth: 2, slug: 'credit', text: 'Credit to give' },
      { depth: 2, slug: 'pipeline', text: 'Where it enters skymap' },
      ...(DATA_SOURCE_NOTES[page.slug]?.shows ? [{ depth: 2, slug: 'in-the-app', text: 'What it becomes in the app' }] : []),
    ];
---

<Docs
  path={page.path}
  description={page.description}
  headings={headings}
  factIds={page.entries.flatMap((entry) => DATA_SOURCE_NOTES[entry.id]?.facts ?? [])}
>
  {
    shared ? (
      <>
        <p>
          The {page.entries.length} entries of this page are small, so they share it. Each has an address of its own: this page’s, with
          the entry’s name in the record after a <code>#</code>.
        </p>
        <p>
          Everything set between two rules is the text of the repository’s <a href={`${REPO_BLOB}/ATTRIBUTIONS.md`}>attributions file</a>
          , with the day the rights holder’s pages were read. It states terms and is not legal advice.{' '}
          <DocLink href={`/docs/data/#${page.family.id}`}>All sources at a glance</DocLink> lists every other source.
        </p>
        {notes.length > 0 && (
          <Recorded checked={checked}>
            {notes.map((text) => (
              <RecordText text={text} />
            ))}
          </Recorded>
        )}
        {page.entries.map((entry) => (
          <>
            <h2 id={entry.id}>
              <RecordText text={entry.record.heading} phrase />
            </h2>
            <DataEntryRecord entry={entry} level={3} />
          </>
        ))}
      </>
    ) : (
      <>
        <DataEntryRecord entry={page.entries[0]!} level={2} />
        <p>
          The record’s name for this entry is “<RecordText text={page.entries[0]!.record.heading} phrase />”. Everything set between two
          rules above is the text of the repository’s <a href={`${REPO_BLOB}/ATTRIBUTIONS.md`}>attributions file</a>. It states terms and
          is not legal advice. <DocLink href={`/docs/data/#${page.family.id}`}>All sources at a glance</DocLink> lists the rest.
        </p>
      </>
    )
  }
</Docs>
