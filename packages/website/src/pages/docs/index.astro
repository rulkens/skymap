---
import Base from '../../layouts/Base.astro';
import DocsMap from '../../components/DocsMap/DocsMap.tsx';
import DocsSearch from '../../components/DocsSearch/DocsSearch.tsx';
import { loadDocsTree } from '../../utils/loadDocsTree';
import { breadcrumbJsonLd } from '../../utils/breadcrumbJsonLd';
---

<Base
  title="Docs | Skymap"
  description="The Skymap documentation: every feature of the app by task, reference tables, the data sources with their licences, the science and how a frame is drawn."
  jsonLd={[breadcrumbJsonLd(Astro.site!, [{ name: 'Docs', path: '/docs/' }])]}
>
  <DocsMap groups={await loadDocsTree()}>
    <DocsSearch slot="search" big client:visible />
  </DocsMap>
</Base>
