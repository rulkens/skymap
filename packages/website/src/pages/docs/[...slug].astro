---
/*
 * One docs page per file of the docs collection, at the file's path. The
 * names a page's text may use without importing them are listed here once.
 * A page's sources are the fact rows it prints through `<Fact>`, found in its
 * text, and the ones its frontmatter adds.
 */
import { getCollection, render } from 'astro:content';

import Caveat from '../../components/Caveat/Caveat.tsx';
import CodeBlock from '../../components/CodeBlock/CodeBlock.tsx';
import DocFigure from '../../components/DocFigure/DocFigure.tsx';
import DocLink from '../../components/DocLink/DocLink.tsx';
import DocTable from '../../components/DocTable/DocTable.tsx';
import Example from '../../components/Example/Example.tsx';
import FactText from '../../components/FactText/FactText.tsx';
import Flow from '../../components/Flow/Flow.tsx';
import Formula from '../../components/Formula/Formula.tsx';
import Keys from '../../components/Keys/Keys.tsx';
import Links from '../../components/Links/Links.tsx';
import Note from '../../components/Note/Note.tsx';
import RepoLink from '../../components/RepoLink/RepoLink.tsx';
import SourceLink from '../../components/SourceLink/SourceLink.tsx';
import Spans from '../../components/Spans/Spans.tsx';
import View from '../../components/View/View.tsx';
import Docs from '../../layouts/Docs.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const printed = [...(entry.body ?? '').matchAll(/<Fact\b[^>]*?\bid="([^"]+)"/g)].map((match) => match[1]!);
---

<Docs
  path={`/docs/${entry.id}/`}
  description={entry.data.description}
  headings={headings}
  factIds={[...printed, ...entry.data.facts]}
>
  <Content
    components={{
      a: DocLink,
      pre: CodeBlock,
      table: DocTable,
      Table: DocTable,
      Figure: DocFigure,
      Fact: FactText,
      Example,
      View,
      Links,
      Keys,
      Note,
      Caveat,
      Source: SourceLink,
      Flow,
      Formula,
      Spans,
      Repo: RepoLink,
    }}
  />
</Docs>
