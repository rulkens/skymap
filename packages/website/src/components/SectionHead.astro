---
/*
 * SectionHead — a section's name with, optionally, a sentence or two beside it
 * (the slot): name left and words right when wide, stacked when narrow.
 * `narrow` breaks a short name over two lines and gives the words the lead's
 * measure, for a page whose sections open on a full sentence.
 */
type Props = { title: string; narrow?: boolean };

const { title, narrow = false } = Astro.props;
---

<div class:list={['head', { narrow }]}>
  <h2>{title}</h2>
  {Astro.slots.has('default') && <div class="lead"><slot /></div>}
</div>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-bottom: 2.5rem;
  }

  h2 {
    max-width: 20ch;
    margin: 0;
  }

  .lead :global(p:last-child) {
    margin-bottom: 0;
  }

  .narrow h2 {
    max-width: 12ch;
  }

  .narrow .lead :global(p) {
    max-width: var(--measure-lead);
  }
</style>
