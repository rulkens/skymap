---
/*
 * RedshiftSpace — the diagram of a "finger of God": one cluster twice, as it
 * lies in space and as a map made from redshifts places it. The same dots are
 * drawn in both rows; in the second each is moved along the line of sight by
 * its own velocity, which is all the effect is. Labels are text outside the
 * drawing, so they keep the page's sizes at every width.
 */
type Props = { label: string };

const { label } = Astro.props;

const W = 360;
const ROW = 84;
const CENTRE = 236;
const RADIUS = 20;
const STRETCH = 4.4;

// Mulberry32: the dots must be the same on every build, and the same in both rows.
let seed = 20261007;
const random = (): number => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const dots = Array.from({ length: 46 }, () => {
  const r = RADIUS * Math.sqrt(random());
  const angle = 2 * Math.PI * random();
  // The sum of three draws is close enough to the bell curve of velocities in a cluster.
  const velocity = (random() + random() + random()) / 1.5 - 1;
  return { x: r * Math.cos(angle), y: r * Math.sin(angle), shift: velocity * RADIUS * STRETCH };
});
const rows = [
  { name: 'In space', y: ROW / 2, at: (dot: (typeof dots)[number]) => dot.x },
  { name: 'In a map made from redshifts', y: ROW * 1.5, at: (dot: (typeof dots)[number]) => dot.x + dot.shift },
];
---

<figure class="diagram" data-embed>
  <svg viewBox={`0 0 ${W} ${ROW * 2}`} role="img" aria-label={label}>
    {
      rows.map((row) => (
        <g>
          <line class="sight" x1="14" y1={row.y} x2={W - 6} y2={row.y} />
          <circle class="us" cx="14" cy={row.y} r="4.5" />
          {dots.map((dot) => (
            <circle class="dot" cx={(CENTRE + row.at(dot)).toFixed(1)} cy={(row.y + dot.y).toFixed(1)} r="1.6" />
          ))}
        </g>
      ))
    }
  </svg>
  <figcaption class="small"><slot /></figcaption>
</figure>

<style>
  .diagram {
    max-width: var(--doc-measure);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .sight {
    stroke: var(--border-divider);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }

  .us {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
  }

  .dot {
    fill: var(--color-fg);
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--site-text-muted);
  }
</style>
