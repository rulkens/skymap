---
/*
 * Offer — one thing we can deliver, as a ledger row: its picture (slot
 * `picture`) beside its name, a sentence or two (the slot), what the code does
 * today and what would be work done for the client (slots `today`, `work`),
 * then one link (slot `link`), in halves of the page grid. `wide` runs the
 * picture across the row and sets the words in a row under it, in thirds:
 * the name, today, the work. Narrow, the name comes first, then the
 * picture, then the rest.
 */
type Props = { title: string; wide?: boolean };

const { title, wide = false } = Astro.props;
---

<article class:list={['offer grid halves', { wide }]}>
  <slot name="picture" />
  <div>
    <h3>{title}</h3>
    <slot />
    <dl>
      <dt>Today</dt>
      <dd><slot name="today" /></dd>
      <dt>Work for you</dt>
      <dd><slot name="work" /></dd>
    </dl>
    <slot name="link" />
  </div>
</article>

<style>
  .offer {
    row-gap: 1.5rem;
    align-items: center;
    padding-block: 3rem;
    border-top: 1px solid var(--border-divider);
  }

  h3 {
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
  }

  @media (min-width: 901px) {
    .offer.wide > :global(*) {
      grid-column: 1 / -1;
      --cols: 12;
    }

    .wide > div,
    .wide dl {
      display: grid;
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }

    /* The list beside them is the taller: the room it leaves goes under the link, not between the words. */
    .wide > div {
      grid-template-rows: auto auto 1fr;
    }

    .wide > div > :global(*) {
      grid-column: 1 / span 4;
    }

    .wide dl {
      grid-area: 1 / 5 / span 3 / -1;
      grid-template-rows: auto 1fr;
      --cols: 8;
    }

    .wide dl > :nth-of-type(1) {
      grid-column: 1 / span 4;
    }

    .wide dl > :nth-of-type(2) {
      grid-column: 5 / span 4;
    }

    .wide dd {
      grid-row: 2;
    }

    .wide dt {
      margin-top: 0.5rem;
    }
  }

  dl {
    margin: 0 0 1rem;
  }

  dt {
    margin-top: 1rem;
    font-size: var(--text-small);
    font-weight: var(--weight-small);
    color: var(--site-text-dim);
  }

  dd {
    max-width: var(--measure);
    margin: 0.15rem 0 0;
    font-size: var(--text-small);
    font-weight: var(--weight-small);
    line-height: 1.5;
    color: var(--site-text-muted);
  }

  @media (max-width: 900px) {
    .offer {
      row-gap: 0;
    }

    .offer > div {
      display: contents;
    }

    .offer > div > :global(*) {
      grid-column: 1 / -1;
    }

    h3 {
      order: -1;
      margin-bottom: 1.25rem;
    }

    .offer > :global(figure) {
      margin-bottom: 1.5rem;
    }
  }
</style>
