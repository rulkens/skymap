---
import AddressStrip from './AddressStrip.astro';
import ObjLink from './ObjLink.astro';
import Shot from './Shot.astro';
import ShotCaption from './ShotCaption.astro';
import { HOME_LINKS } from '../data/homeLinks';
import { sitePath } from '../utils/sitePath';
---

<section class="wrap section row" id="classroom">
  <div class="frame">
    <Shot id="classroom-jupiter" sizes="(max-width: 900px) 60vw, 55vw" />
    <!-- The example address is built from the same hash the deep-link test parses. -->
    <AddressStrip hash={HOME_LINKS.classroom} />
    <ShotCaption id="classroom-jupiter" open={false} />
  </div>
  <div class="copy">
    <h2>Use it in the classroom</h2>
    <p>
      Point the camera at Jupiter, set the date, and copy the address. Every pupil who opens the link lands on Jupiter
      at that date. No accounts, nothing to install. The link carries the date, so next year’s class sees the same
      sky.
    </p>
    <ObjLink href={sitePath('/classroom/')}>Classroom guide</ObjLink>
  </div>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 5rem;
    align-items: center;
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .frame :global(.caption) {
    margin-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
