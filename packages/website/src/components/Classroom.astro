---
import AddressStrip from './AddressStrip.astro';
import ObjLink from './ObjLink/ObjLink.tsx';
import Shot from './Shot/Shot.tsx';
import ShotCaption from './ShotCaption/ShotCaption.tsx';
import { HOME_LINKS } from '../data/homeLinks';
import { sitePath } from '../utils/sitePath';
---

<section class="wrap section row grid" id="classroom">
  <div class="frame">
    <Shot id="classroom-jupiter" sizes="(max-width: 900px) calc(100vw - 2.5rem), (max-width: 1239px) calc(50vw - 4.25rem), 34.5rem" />
    <!-- The example address is built from the same hash the deep-link test parses. -->
    <AddressStrip hash={HOME_LINKS.classroom} />
    <ShotCaption id="classroom-jupiter" open={false} />
  </div>
  <div class="copy">
    <h2>Use it in the classroom</h2>
    <p>
      Set up a view and copy its address. Every pupil who opens the link starts on the same object at the same
      date, and so does next year’s class.
    </p>
    <ObjLink hang href={sitePath('/classroom/')}>Use Skymap in the classroom</ObjLink>
  </div>
</section>

<style>
  .row {
    row-gap: 2.5rem;
    align-items: center;
  }

  /* Six columns of the page grid and five, with an empty one between. */
  @media (min-width: 901px) {
    .frame {
      grid-column: span 6;
      --cols: 6;
    }

    .copy {
      grid-column: 8 / -1;
    }
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .frame :global(.caption) {
    margin-top: 0.5rem;
  }
</style>
