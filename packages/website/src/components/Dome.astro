---
import Disc from './Disc.astro';
import ObjLink from './ObjLink/ObjLink.tsx';
import ShotCaption from './ShotCaption/ShotCaption.tsx';
import { sitePath } from '../utils/sitePath';
---

<section class="wrap section row grid" id="dome">
  <figure>
    <div class="dome">
      <Disc id="dome-saturn" sizes="(max-width: 900px) calc(85vw - 2.125rem), (max-width: 1239px) calc(41.7vw - 4rem), 28.25rem" />
    </div>
    <figcaption><ShotCaption id="dome-saturn" /></figcaption>
  </figure>
  <div class="copy">
    <h2>Put it on a dome</h2>
    <p>
      Skymap can render fisheye projections live or to video, in 4K. There are also many options to integrate Skymap
      into a kiosk setup.
    </p>
    <ObjLink hang href={sitePath('/domes/')}>For domes and museums</ObjLink>
  </div>
</section>

<style>
  .row {
    row-gap: 3.5rem;
    align-items: center;
  }

  figure {
    margin: 0;
  }

  /* Five columns of the page grid and six, with an empty one between. */
  @media (min-width: 901px) {
    figure {
      grid-column: span 5;
      --cols: 5;
    }

    .copy {
      grid-column: 7 / -1;
    }
  }

  figcaption {
    max-width: 38.75rem;
    margin: 2.5rem auto 0;
  }

  .dome {
    max-width: 38.75rem;
    margin-inline: auto;
  }

  .proof {
    font-size: var(--text-h3);
  }

  @media (max-width: 900px) {
    .dome {
      max-width: 85%;
    }
  }
</style>
