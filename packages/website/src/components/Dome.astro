---
import ObjLink from './ObjLink.astro';
import Shot from './Shot.astro';
import ShotCaption from './ShotCaption.astro';
import { sitePath } from '../utils/sitePath';
---

<section class="wrap section row" id="dome">
  <figure>
    <!-- The frame is the app's own fisheye output, a disc inscribed in a square: the round mask trims only its black corners. -->
    <div class="dome">
      <Shot id="dome-saturn" sizes="(max-width: 900px) 60vw, 40vw" />
    </div>
    <figcaption><ShotCaption id="dome-saturn" /></figcaption>
  </figure>
  <div class="copy">
    <h2>Put it on a dome</h2>
    <p class="proof">In September 2026 we showed skymap in the dome at Wisdome Malmö.</p>
    <p>
      We can output a fisheye frame, the round picture a dome projector needs, live from the app or rendered as a
      film. We can also build a kiosk that opens on one exhibit.
    </p>
    <ObjLink href={sitePath('/domes/')}>Domes, museums and commissions</ObjLink>
  </div>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: 5rem;
    align-items: center;
  }

  figure {
    margin: 0;
  }

  figcaption {
    max-width: 38.75rem;
    margin: 2.5rem auto 0;
  }

  .dome {
    width: 100%;
    max-width: 38.75rem;
    aspect-ratio: 1;
    margin-inline: auto;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgb(232 238 255 / 0.5),
      0 0 0 1.125rem #000,
      0 0 0 1.1875rem rgb(232 238 255 / 0.18);
  }

  .dome :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .proof {
    font: var(--weight-display) var(--text-h3) / 1.3 var(--font-family-display);
    color: var(--color-fg);
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .dome {
      max-width: 85%;
    }
  }
</style>
