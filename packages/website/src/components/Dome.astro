---
import Disc from './Disc.astro';
import ObjLink from './ObjLink.astro';
import ShotCaption from './ShotCaption.astro';
import { sitePath } from '../utils/sitePath';
---

<section class="wrap section row grid" id="dome">
  <figure>
    <div class="dome">
      <Disc id="dome-saturn" sizes="(max-width: 900px) 60vw, 40vw" />
    </div>
    <figcaption><ShotCaption id="dome-saturn" /></figcaption>
  </figure>
  <div class="copy">
    <h2>Put it on a dome</h2>
    <p class="proof">In September 2026 we showed skymap in the dome at Wisdome Malmö.</p>
    <p>
      We can output a fisheye frame, the round picture a dome projector needs, live from the app or rendered as a
      film. We can also build a kiosk that opens on one exhibit.
    </p>
    <ObjLink hang href={sitePath('/domes/')}>Domes and museums</ObjLink>
  </div>
</section>

<style>
  .row {
    row-gap: 3.5rem;
    align-items: center;
  }

  figure {
    margin: 0;
  }

  /* Five columns of the page grid and six, with an empty one between. */
  @media (min-width: 901px) {
    figure {
      grid-column: span 5;
      --cols: 5;
    }

    .copy {
      grid-column: 7 / -1;
    }
  }

  figcaption {
    max-width: 38.75rem;
    margin: 2.5rem auto 0;
  }

  .dome {
    max-width: 38.75rem;
    margin-inline: auto;
  }

  .proof {
    font-size: var(--text-h3);
  }

  @media (max-width: 900px) {
    .dome {
      max-width: 85%;
    }
  }
</style>
