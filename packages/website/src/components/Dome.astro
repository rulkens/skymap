---
import { Picture } from 'astro:assets';

import ObjLink from './ObjLink.astro';
import still from '../assets/still-cosmic-web.webp';
import { sitePath } from '../utils/sitePath';
---

<section class="wrap row" id="dome">
  <div class="dome">
    <Picture
      src={still}
      alt="The cosmic web as skymap draws it: a purple and orange density map beside catalogued galaxies, cropped to a circle like a dome."
      formats={["avif", "webp"]}
    fallbackFormat="webp"
      widths={[480, 800, 1200]}
      sizes="(max-width: 900px) 90vw, 40vw"
      loading="lazy"
    />
  </div>
  <div class="copy">
    <h2>Put it on a dome</h2>
    <p class="proof">In September 2026 we showed skymap in the dome at Wisdome Malmö, at Malmö museum.</p>
    <p>
      We can make a version for yours: live fisheye output, a 4K or fulldome film, or a kiosk that opens on one
      exhibit.
    </p>
    <ObjLink href={sitePath('/venues/')}>Work with us</ObjLink>
  </div>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: 5rem;
    align-items: center;
    padding-block: 2rem var(--section-space);
  }

  .dome {
    width: 100%;
    max-width: 38.75rem;
    aspect-ratio: 1;
    margin-inline: auto;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgb(232 238 255 / 0.5),
      0 0 0 1.125rem #000,
      0 0 0 1.1875rem rgb(232 238 255 / 0.18);
  }

  .dome :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .proof {
    font: var(--weight-display) 1.5rem / 1.3 var(--font-family-display);
    color: var(--color-fg);
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
      gap: 3.5rem;
      padding-block: 0 var(--section-space);
    }

    .dome {
      max-width: 85%;
    }
  }
</style>
