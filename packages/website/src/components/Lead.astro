---
import ViewLink from './ViewLink.astro';
import PictureBand from './PictureBand.astro';
import ShotCaption from './ShotCaption.astro';
import { appLink } from '../data/appLink';
import { HOME_LINKS } from '../data/homeLinks';
---

<PictureBand id="earth-terminator" tall="earth-terminator-portrait" gap="half">
  <h2>From a park to the cosmic web, without a cut</h2>
  <p class="say">
    Start just above Søndermarken, a park in Copenhagen, and pull back. The park shrinks into the Earth, the Earth
    into a dot beside the Sun, and the Sun is soon lost among the stars of the Gaia survey. By the time the dots are
    galaxies, from surveys such as SDSS, 2MRS and GLADE, you can see the threads they form: the cosmic web.
  </p>
  <ViewLink hang href={appLink(HOME_LINKS.parkFlight)}>Play the pull-back from the park</ViewLink>
  <ShotCaption id="earth-terminator" />
</PictureBand>

<style>
  h2 {
    max-width: 13ch;
  }

  .say {
    max-width: 27rem;
    font-size: var(--text-lead);
  }

  @media (max-width: 900px) {
    h2 {
      max-width: 17ch;
    }
  }
</style>
