---
/*
 * Claims — a list of sourced statements, each a short name beside the fact
 * row's own words and the link that backs them. Wide, names run down a left
 * column so the list scans: three columns of the page grid, or two in a list
 * that has half the page (`narrow`). Narrow, each name sits over its statement.
 */
import { fact } from '../data/fact';

type Props = { items: readonly { term: string; id: string }[]; narrow?: boolean };

const { items, narrow = false } = Astro.props;
---

<dl class:list={['claims small', { narrow }]}>
  {
    items.map(({ term, id }) => {
      const row = fact(id);
      return (
        <div>
          <dt>{term}</dt>
          <dd>
            {row.text} <a href={row.source}>Source: {row.sourceLabel}</a>
          </dd>
        </div>
      );
    })
  }
</dl>

<style>
  .claims {
    margin: 0;
  }

  .claims > div {
    display: grid;
    grid-template-columns: repeat(var(--cols, 12), minmax(0, 1fr));
    gap: 0.25rem var(--col-gap);
    padding-block: 1rem;
    border-top: 1px solid var(--border-divider);
  }

  dt {
    grid-column: span 3;
    color: var(--color-fg);
  }

  dd {
    grid-column: 4 / -1;
    /* About 75 characters of the small text. */
    max-width: 34rem;
    margin: 0;
    color: var(--site-text-muted);
  }

  .narrow dt {
    grid-column: span 2;
  }

  .narrow dd {
    grid-column: 3 / -1;
  }

  /* The source reads as a reference, not as part of the sentence: its own line, still 44px tall to the thumb. */
  a {
    display: block;
    width: fit-content;
    padding-block: 0.625rem;
    margin-bottom: -0.625rem;
  }

  @media (max-width: 900px) {
    .claims dt,
    .claims dd {
      grid-column: 1 / -1;
    }
  }
</style>
