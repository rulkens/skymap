---
/*
 * FeatureShot — the picture of one group of the Features page, with its label
 * under it. Wide, the picture runs out to the window's right edge (`--bleed`,
 * the page column's own right margin), cut to `--shot-room` high where a
 * window is too short for it.
 */
import type { FeatureGroup } from '../@types/FeatureGroup';
import Shot from './Shot/Shot.tsx';
import ShotCaption from './ShotCaption/ShotCaption.tsx';

type Props = { group: FeatureGroup; sizes: string; eager?: boolean };

const { group, sizes, eager = false } = Astro.props;
---

{
  group.shot && (
    <figure class="fshot" data-shot-of={group.id}>
      <div class="picture">
        <Shot id={group.shot} tall={group.tall} sizes={sizes} eager={eager} />
      </div>
      <figcaption>
        <ShotCaption id={group.shot} />
      </figcaption>
    </figure>
  )
}

<style>
  .fshot {
    margin: 0;
  }

  .picture :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.5rem;
  }

  @media (min-width: 901px) {
    .picture {
      --bleed: max(var(--gutter), (100vw - var(--wrap-max)) / 2 + var(--gutter));
      margin-right: calc(-1 * var(--bleed));
    }

    /* The app's panels stand at the left of an interface shot, so a cut keeps that side. */
    .picture :global(img) {
      max-height: var(--shot-room, none);
      object-fit: cover;
      object-position: 0 50%;
    }
  }

  /* Narrow, the picture runs to both edges of the screen; its label keeps the text edge. */
  @media (max-width: 900px) {
    .picture {
      margin-inline: calc(-1 * var(--gutter));
    }
  }
</style>
