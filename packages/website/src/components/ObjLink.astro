---
/*
 * ObjLink — a link dressed as the site's one control, the ring plus a label
 * (styles/site.css `.ring`, shared with the menu's summary and real buttons).
 * A drawing that says where the link goes takes the marker's place, and the
 * ring is drawn around it when the link is pointed at, focused or the current
 * page: the destination page's own icon, or the mark of a link that leaves the
 * site (utils/linkIcon.ts), unless `icon` names another. A jump within the
 * page keeps the plain marker. `hang`
 * puts the marker or drawing in the margin so the label starts at the text
 * edge: for a link under text, in a column with room to its left.
 */
import type { HTMLAttributes } from 'astro/types';

import type { IconName } from '../@types/IconName';
import { linkIcon } from '../utils/linkIcon';
import Icon from './Icon.astro';

type Props = HTMLAttributes<'a'> & {
  href: string;
  size?: 'small' | 'default' | 'big';
  icon?: IconName;
  hang?: boolean;
};

const { size = 'default', icon, hang = false, class: extra, ...rest } = Astro.props;
const drawing = icon ?? linkIcon(rest.href, import.meta.env.BASE_URL);
---

<a class:list={['ring', size !== 'default' && size, hang && 'hang', extra]} {...rest}>
  {drawing && <Icon name={drawing} />}<slot />
</a>
