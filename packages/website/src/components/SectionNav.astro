---
/*
 * SectionNav — the sections of a long page, as a contents row under its
 * opening: a quiet heading that says what the row is, then one cell per
 * section, in equal columns of the page grid, with a drawing and the
 * section's name. Plain anchors, no script. The ring around the drawing is the top bar's selection
 * (styles/site.css `.ring > .glyph`); hairlines and a dim heading keep this
 * second navigation quieter than the bar.
 */
import type { IconName } from '../@types/IconName';
import Icon from './Icon.astro';

type Props = { items: { href: string; label: string; icon: IconName }[] };

const { items } = Astro.props;
const headingId = 'section-nav-label';
---

<nav class="wrap" aria-labelledby={headingId}>
  <p class="heading small" id={headingId}>On this page</p>
  <ol class="grid" style={`--span: ${12 / items.length}`}>
    {
      items.map((item) => (
        <li>
          <a class="glyph-ring" href={item.href}>
            <Icon name={item.icon} />
            <span class="name">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  nav {
    padding-top: 3.5rem;
  }

  .heading {
    max-width: none;
    margin: 0 0 0.875rem;
    color: var(--site-text-dim);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--border-divider);
  }

  li {
    position: relative;
    grid-column: span var(--span);
  }

  /* The divider stands in the middle of the gap, so each cell's words start on a line of the page grid. */
  li + li::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 calc(var(--col-gap) / -2);
    border-left: 1px solid var(--border-divider);
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    min-height: var(--tap);
    padding: 1.75rem 0;
    color: var(--color-fg);
    text-decoration: none;
  }

  /* The focus outline would be cut by the neighbouring cell's edge if it stood off. */
  a:focus-visible {
    outline-offset: -2px;
  }

  .name {
    font: var(--weight-display) var(--text-h3) / 1.1 var(--font-family-display);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  /* Narrow: a contents list, drawing beside the words, two columns while they fit. */
  @media (max-width: 900px) {
    nav {
      padding-top: 2.5rem;
    }

    ol {
      border-top: 0;
    }

    li {
      grid-column: span 6;
      border-top: 1px solid var(--border-divider);
    }

    li:nth-child(odd)::before {
      content: none;
    }

    a {
      flex-direction: row;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.25rem 0 1.25rem 0.4375rem;
    }

    .name {
      font-size: 1.375rem;
    }
  }

  @media (max-width: 560px) {
    li {
      grid-column: 1 / -1;
    }

    li::before {
      content: none;
    }
  }

</style>
