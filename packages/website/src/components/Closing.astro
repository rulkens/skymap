---
import ObjLink from './ObjLink.astro';
import Shot from './Shot.astro';
import ShotCaption from './ShotCaption.astro';
import { appLink } from '../data/appLink';
---

<section class="closing">
  <div class="back">
    <Shot id="saturn" tall="saturn-portrait" sizes="100vw" />
  </div>
  <div class="wrap copy">
    <h2>Every picture here is an address</h2>
    <p>Open one and you are standing where it was taken. From there the camera is yours.</p>
    <ObjLink size="big" href={appLink()}>Fly it yourself</ObjLink>
    <ShotCaption id="saturn" />
  </div>
</section>

<style>
  /* Wide: Saturn on the left of the frame, the words on the right. */
  .closing {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(56.25vw, 92svh);
    margin-top: var(--section-space);
    background: #000;
  }

  .back {
    position: absolute;
    inset: 0;
  }

  .back :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 50%;
  }

  .back::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0) 16%, rgb(0 0 0 / 0) 84%, #000 100%),
      linear-gradient(270deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.65) 32%, rgb(0 0 0 / 0) 56%);
  }

  .copy {
    position: relative;
    width: 100%;
    padding-block: 5rem;
  }

  .copy > :global(*) {
    margin-left: 58%;
  }

  h2 {
    font-size: clamp(2.5rem, 4.2vw, 4.25rem);
  }

  .copy :global(.ring) {
    display: flex;
  }

  .copy :global(.caption) {
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .closing {
      display: block;
      min-height: 0;
    }

    .back {
      position: relative;
    }

    .back :global(img) {
      height: auto;
      object-position: center;
    }

    .back::after {
      background: linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0) 14%, rgb(0 0 0 / 0) 68%, #000 100%);
    }

    .copy {
      margin-top: -3.5rem;
      padding-block: 0;
    }

    .copy > :global(*) {
      margin-left: 0;
    }
  }
</style>
