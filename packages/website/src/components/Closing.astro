---
import ObjLink from './ObjLink.astro';
import PictureBand from './PictureBand.astro';
import ShotCaption from './ShotCaption.astro';
import { appLink } from '../data/appLink';
---

<PictureBand id="saturn" tall="saturn-portrait" words="right">
  <h2>Every picture here is an address</h2>
  <p>Open one and you are standing where it was taken. From there the camera is yours.</p>
  <ObjLink size="big" class="go" href={appLink()}>Fly it yourself</ObjLink>
  <ShotCaption id="saturn" />
</PictureBand>

<style>
  h2 {
    font-size: clamp(2.5rem, 4.2vw, 4.25rem);
  }

  .go {
    display: flex;
  }
</style>
