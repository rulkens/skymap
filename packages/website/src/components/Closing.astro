---
import OpenApp from './OpenApp.astro';
import PictureBand from './PictureBand.astro';
import ShotCaption from './ShotCaption.astro';
---

<PictureBand id="saturn" tall="saturn-portrait" words="right">
  <h2>Most pictures here are addresses</h2>
  <p>Choose “Open this view” under one and the app opens on the same view. From there you can move the camera.</p>
  <OpenApp class="go" />
  <ShotCaption id="saturn" />
</PictureBand>

<style>
  .go {
    display: flex;
    width: fit-content;
  }
</style>
