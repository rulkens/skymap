---
/*
 * Spans — `<Spans ticks={[…]} spans={[…]} />` on a docs page: stretches of
 * one scale, each a bar on a common axis with its name and a sentence under
 * it. `from`, `to` and a tick's `at` are in the axis's own units (powers of
 * ten on a logarithmic one); a span with no `to` has no end and runs off the
 * edge as a dashed line. The words are text, not part of the drawing, so
 * they keep the page's sizes at every width.
 */
type Props = {
  label: string;
  min: number;
  max: number;
  ticks: readonly { at: number; label: string }[];
  spans: readonly { name: string; text: string; from: number; to?: number }[];
};

const { label, min, max, ticks, spans } = Astro.props;
const x = (value: number) => ((value - min) / (max - min)) * 100;
---

<figure class="spans" data-embed role="group" aria-label={label}>
  <ol>
    {
      spans.map((span) => (
        <li>
          <svg viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true">
            <line class="axis" x1="0" y1="2" x2="100" y2="2" />
            <line class="bar" x1={x(span.from)} y1="2" x2={x(span.to ?? max - (max - min) * 0.12)} y2="2" />
            {span.to === undefined && (
              <line class="bar open" x1={x(max - (max - min) * 0.12)} y1="2" x2="100" y2="2" />
            )}
          </svg>
          <b>{span.name}</b>
          <span class="small">{span.text}</span>
        </li>
      ))
    }
  </ol>
  <div class="ticks small" aria-hidden="true">
    {ticks.map((tick) => <span style={`left:${x(tick.at)}%`}>{tick.label}</span>)}
  </div>
</figure>

<style>
  .spans {
    margin: 2rem 0 2.5rem;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    padding-bottom: 1.25rem;
  }

  svg {
    width: 100%;
    height: 0.75rem;
    margin-bottom: 0.25rem;
    fill: none;
  }

  line {
    vector-effect: non-scaling-stroke;
  }

  .axis {
    stroke: var(--border-divider);
    stroke-width: 1;
  }

  .bar {
    stroke: var(--color-accent);
    stroke-width: 5;
  }

  .open {
    stroke-dasharray: 3 4;
  }

  b {
    font: var(--weight-display) 1.25rem / 1.3 var(--font-family-display);
    color: var(--color-fg);
  }

  li span {
    max-width: var(--doc-measure);
    color: var(--site-text-muted);
    line-height: 1.45;
  }

  /* The scale under the bars: each mark hangs from its place on the axis. */
  .ticks {
    position: relative;
    height: 2.75rem;
    border-top: 1px solid var(--border-divider);
    color: var(--site-text-dim);
  }

  .ticks span {
    position: absolute;
    top: 0;
    padding-top: 0.5rem;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .ticks span::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    height: 0.375rem;
    border-left: 1px solid var(--border-divider);
  }

  .ticks span:first-child {
    transform: none;
  }

  .ticks span:first-child::before {
    left: 0;
  }

  .ticks span:last-child {
    transform: translateX(-100%);
  }

  .ticks span:last-child::before {
    left: 100%;
  }

  /* A phone has room for every other mark. */
  @media (max-width: 699px) {
    .ticks span:nth-child(even) {
      display: none;
    }
  }
</style>
