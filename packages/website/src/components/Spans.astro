---
/*
 * Spans — `<Spans ticks={[…]} spans={[…]} />` on a docs page: stretches of
 * one scale, each a line on a common axis with a ring at each end, its name
 * and a sentence under it. `from`, `to` and a tick's `at` are in the axis's
 * own units (powers of ten on a logarithmic one); a span with no `to` has no
 * end: it runs off the edge dashed, and the label under the scale says so.
 * The slot is the rest of that label. The words are text, not part of the
 * drawing, so they keep the page's sizes at every width.
 */
type Props = {
  label: string;
  min: number;
  max: number;
  ticks: readonly { at: number; label: string }[];
  spans: readonly { name: string; text: string; from: number; to?: number }[];
};

const { label, min, max, ticks, spans } = Astro.props;
const x = (value: number) => ((value - min) / (max - min)) * 100;
// Where an endless span turns from a line into dashes.
const OPEN_FROM = 88;
// A phone has room for three marks: the two ends of the scale and the one nearest its middle.
const middle = Math.floor((ticks.length - 1) / 2);
const open = spans.some((span) => span.to === undefined);
---

<figure class="spans" data-embed role="group" aria-label={label}>
  <ol>
    {
      spans.map((span) => (
        <li>
          <div class="axis" aria-hidden="true">
            <i class="bar" style={`left:${x(span.from)}%;right:${100 - (span.to === undefined ? OPEN_FROM : x(span.to))}%`} />
            {span.to === undefined && <i class="bar open" style={`left:${OPEN_FROM}%;right:0`} />}
          </div>
          <b>{span.name}</b>
          <span class="small">{span.text}</span>
        </li>
      ))
    }
  </ol>
  <div class="ticks small" aria-hidden="true">
    {ticks.map((tick, i) => <span class:list={{ middle: i === middle }} style={`left:${x(tick.at)}%`}>{tick.label}</span>)}
  </div>
  {
    (open || Astro.slots.has('default')) && (
      <figcaption class="small">
        <slot />
        {open && ' A dashed end has no far limit.'}
      </figcaption>
    )
  }
</figure>

<style>
  .spans {
    margin: 2rem 0 2.5rem;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    padding-bottom: 1.25rem;
  }

  /* The scale as a faint line, and on it the span: the site's 1px line, a ring where it ends. */
  .axis {
    position: relative;
    height: 0.4375rem;
    margin-block: 0.25rem 0.5rem;
    background: linear-gradient(var(--border-divider), var(--border-divider)) center / 100% 1px no-repeat;
  }

  .bar {
    position: absolute;
    top: 50%;
    border-top: 1px solid var(--color-accent);
    transform: translateY(-50%);
  }

  .bar::before,
  .bar:not(.open, :has(+ .open))::after {
    content: '';
    position: absolute;
    left: 0;
    top: -0.25rem;
    width: 0.4375rem;
    height: 0.4375rem;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-bg);
  }

  .bar::after {
    left: auto;
    right: 0;
  }

  .bar.open {
    border-top-style: dashed;
  }

  .bar.open::before {
    content: none;
  }

  b {
    font: var(--weight-display) 1.25rem / 1.3 var(--font-family-display);
    color: var(--color-fg);
  }

  li span {
    max-width: var(--doc-measure);
    color: var(--site-text-muted);
    line-height: 1.45;
  }

  /* The scale under the bars: each mark hangs from its place on the axis. */
  .ticks {
    position: relative;
    height: 2.75rem;
    border-top: 1px solid var(--border-divider);
    color: var(--site-text-dim);
  }

  .ticks span {
    position: absolute;
    top: 0;
    padding-top: 0.5rem;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .ticks span::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    height: 0.375rem;
    border-left: 1px solid var(--border-divider);
  }

  .ticks span:first-child {
    transform: none;
  }

  .ticks span:first-child::before {
    left: 0;
  }

  .ticks span:last-child {
    transform: translateX(-100%);
  }

  .ticks span:last-child::before {
    left: 100%;
  }

  figcaption {
    max-width: var(--doc-measure);
    color: var(--site-text-dim);
    line-height: 1.45;
  }

  @media (max-width: 699px) {
    .ticks span:not(:first-child, :last-child, .middle) {
      display: none;
    }
  }
</style>
