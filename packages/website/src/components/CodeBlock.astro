---
/*
 * CodeBlock — a block of code between two rules: a fenced block of a docs
 * page (its slot), or `text` from data. Long lines wrap inside the rules, so
 * nothing is out of sight and nothing scrolls sideways. A fenced block is a
 * command or an address: it wraps between words, and inside one only when
 * the word is wider than the block, because a hyphen at a line's end could
 * be the word's own. The copy control takes the text as written.
 */
import CopyButton from './CopyButton.astro';

type Props = { text?: string; label?: string };

// A fenced block reaches the slot as escaped HTML; the clipboard gets the characters.
const ENTITIES: Record<string, string> = { amp: '&', lt: '<', gt: '>', quot: '"', '#39': "'", '#x27': "'" };

const { label = 'Copy these lines' } = Astro.props;
const fenced = Astro.props.text === undefined;
const text =
  Astro.props.text ??
  (await Astro.slots.render('default'))
    .replace(/<[^>]+>/g, '')
    .replace(/&(amp|lt|gt|quot|#39|#x27);/g, (_, name: string) => ENTITIES[name]!)
    .trim();
---

<div class="code-block" data-embed>
  <pre><code>{fenced ? text.split(/(\s+)/).map((run) => (/\s/.test(run) ? run : <span>{run}</span>)) : text}</code></pre>
  <CopyButton text={text} label={label} />
</div>

<style>
  .code-block {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0 0 var(--stack);
    border-block: 1px solid var(--border-divider);
  }

  pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding-block: 1rem;
    font: var(--weight-small) 0.9375rem / 1.55 var(--font-family-mono);
    color: var(--color-fg);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  code {
    font: inherit;
  }

  span {
    display: inline-block;
    max-width: 100%;
  }

  /* The control stands on the first line of the code: its 44px are centred on that line's height. */
  .code-block > :global(button) {
    margin-top: 0.375rem;
  }
</style>
