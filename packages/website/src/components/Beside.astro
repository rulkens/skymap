---
/*
 * Beside — two blocks side by side on the page grid, five columns and six with
 * an empty one between, stacked when narrow. `picture` says the first block is
 * a picture and how wide it may be when stacked: wide, the words are centred
 * on it. `wordsFirst` puts the second block first when they stack, so a name
 * comes before its picture.
 */
type Props = { picture?: string; wordsFirst?: boolean };

const { picture, wordsFirst = false } = Astro.props;
---

<div class:list={['beside grid', { picture, flip: wordsFirst }]} style={picture && `--picture:${picture}`}>
  <slot />
</div>

<style>
  .beside {
    row-gap: 2.5rem;
    align-items: start;
  }

  .picture {
    align-items: center;
  }

  @media (min-width: 901px) {
    .beside > :global(:first-child) {
      grid-column: span 5;
      --cols: 5;
    }

    /* By position: a component's own script may follow the second block. */
    .beside > :global(:nth-child(2)) {
      grid-column: 7 / -1;
      --cols: 6;
    }
  }

  @media (max-width: 900px) {
    .picture > :global(:first-child) {
      max-width: var(--picture);
    }

    .flip > :global(:last-child) {
      order: -1;
    }
  }
</style>
