---
/*
 * Caveat — an admission set apart from a section's claims: where something
 * falls short, or is planned and not yet true. Its name and its words (the
 * slot) stand behind a rule in the accent, not in a box.
 */
type Props = { title: string };

const { title } = Astro.props;
---

<div class="caveat">
  <h3>{title}</h3>
  <slot />
</div>

<style>
  .caveat {
    max-width: 46rem;
    margin-top: 3.5rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-accent);
  }

  h3 {
    margin: 0 0 1rem;
  }

  .caveat :global(p) {
    max-width: none;
  }

  .caveat :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
