---
/*
 * ContactForm — the commission enquiry. With no endpoint and site key
 * configured (data/contact.ts) it prints a plain message in place of the form.
 * With them, it posts four fields and a Turnstile token as JSON; the script only
 * reports what the server answered, so "sent" is never shown for a message that
 * was not accepted. The Turnstile script, a third-party request, loads only when
 * the form scrolls into view, and this component is on no other page. The spam
 * check needs script, so without it the form says so and points to GitHub.
 */
import ObjLink from './ObjLink.astro';
import { CONTACT_ENDPOINT, ISSUES_URL, TURNSTILE_SITE_KEY } from '../data/contact';
import { sitePath } from '../utils/sitePath';

const FIELDS = [
  { name: 'name', label: 'Your name', type: 'text', autocomplete: 'name', missing: 'Enter your name.' },
  {
    name: 'organisation',
    label: 'Organisation',
    type: 'text',
    autocomplete: 'organization',
    missing: 'Enter the name of your dome, museum or organisation.',
  },
  {
    name: 'email',
    label: 'Email address',
    type: 'email',
    autocomplete: 'email',
    hint: 'We use it only to answer you.',
    missing: 'Enter an email address, like name@example.org.',
  },
] as const;
---

{
  CONTACT_ENDPOINT ? (
    <form class="form" method="post" action={CONTACT_ENDPOINT} data-contact data-sitekey={TURNSTILE_SITE_KEY}>
      <div class="summary" role="alert" tabindex="-1" data-summary hidden />
      <p class="note small">All four fields are needed.</p>
      {FIELDS.map((field) => (
        <div class="field">
          <label for={`contact-${field.name}`}>{field.label}</label>
          {'hint' in field && (
            <p class="hint small" id={`contact-${field.name}-hint`}>
              {field.hint}
            </p>
          )}
          <input
            id={`contact-${field.name}`}
            name={field.name}
            type={field.type}
            autocomplete={field.autocomplete}
            required
            data-missing={field.missing}
            aria-describedby={'hint' in field ? `contact-${field.name}-hint` : undefined}
          />
          <p class="error small" id={`contact-${field.name}-error`} hidden />
        </div>
      ))}
      <div class="field">
        <label for="contact-message">What you have in mind</label>
        <p class="hint small" id="contact-message-hint">
          The dome or room, the screen, the audience, and a date if there is one. A few lines are enough.
        </p>
        <textarea
          id="contact-message"
          name="message"
          rows="6"
          required
          data-missing="Tell us in a line or two what you have in mind."
          aria-describedby="contact-message-hint"
        />
        <p class="error small" id="contact-message-error" hidden />
      </div>
      <!-- Honeypot: people never see or reach this field; a filled one marks the post as automated. -->
      <div class="leave" aria-hidden="true">
        <label for="contact-website">Leave this field empty</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <p class="note small">
        Sending this gives us these four fields as an email. We use them to answer you and for nothing else. What we
        keep, and for how long, is on the <a href={sitePath('/privacy/')}>privacy page</a>.
      </p>
      <div class="check" data-turnstile></div>
      <noscript>
        <p class="note small">
          The spam check needs JavaScript, so this form cannot send without it. The
          <a href={ISSUES_URL}>issue list on GitHub</a> is public.
        </p>
      </noscript>
      <button class="ring" type="submit">Send the message</button>
      <p class="status" role="status" data-status />
    </form>
  ) : (
    <div class="closed">
      <p class="lead">The contact form is not open yet.</p>
      <p>
        Until it is, open an issue on GitHub and say only that you would like to talk about a dome or an exhibit. We
        will reply with an address. Issues are public, so leave the details for the email.
      </p>
      <ObjLink hang href={ISSUES_URL}>Open an issue on GitHub</ObjLink>
      <p class="note small">
        What the site and the app load and keep today, and the plan for this form, are on the{' '}
        <a href={sitePath('/privacy/')}>privacy page</a>.
      </p>
    </div>
  )
}

<script>
  import type { TurnstileApi } from '../@types/TurnstileApi';

  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const summary = form.querySelector<HTMLElement>('[data-summary]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-missing]')];
    // Our own messages replace the browser's bubbles, which screen readers announce unevenly.
    form.noValidate = true;

    // The widget is a request to Cloudflare, so it waits until the form is on screen. A token is single-use: reset after every attempt.
    const turnstile = () => (window as unknown as { turnstile?: TurnstileApi }).turnstile;
    let token = '';
    let blocked = false;
    let widgetId: string | undefined;
    const loadWidget = () => {
      const script = Object.assign(document.createElement('script'), {
        src: 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit',
        async: true,
        onerror: () => (blocked = true),
        onload: () => {
          widgetId = turnstile()?.render(form.querySelector<HTMLElement>('[data-turnstile]')!, {
            sitekey: form.dataset.sitekey,
            theme: 'dark',
            callback: (value: string) => (token = value),
            'expired-callback': () => (token = ''),
            'error-callback': () => (token = ''),
          });
        },
      });
      document.head.append(script);
    };
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        loadWidget();
      },
      { rootMargin: '300px' },
    ).observe(form);

    const check = (field: HTMLInputElement | HTMLTextAreaElement): string => {
      const empty = field.value.trim() === '';
      const message = empty || !field.validity.valid ? field.dataset.missing! : '';
      const error = form.querySelector<HTMLElement>(`#${field.id}-error`)!;
      error.textContent = message;
      error.hidden = message === '';
      field.setAttribute('aria-invalid', String(message !== ''));
      const hint = form.querySelector(`#${field.id}-hint`) ? `${field.id}-hint ` : '';
      field.setAttribute('aria-describedby', `${hint}${message ? error.id : ''}`.trim());
      return message;
    };

    // Fields are checked on submit only: a message that vanished on blur would move the button out from under a click.
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      const problems = fields.map((field) => ({ field, message: check(field) })).filter((p) => p.message);
      summary.hidden = problems.length === 0;
      if (problems.length > 0) {
        summary.replaceChildren(
          Object.assign(document.createElement('p'), {
            textContent: `The message was not sent. ${problems.length === 1 ? 'One field needs' : `${problems.length} fields need`} attention.`,
          }),
          ...problems.map(({ field, message }) =>
            Object.assign(document.createElement('a'), { href: `#${field.id}`, textContent: message }),
          ),
        );
        summary.focus();
        return;
      }
      if (!token) {
        status.textContent = blocked
          ? 'The spam check could not load, so this form cannot send from your browser. The issue list on GitHub reaches us too.'
          : 'The spam check has not finished. Wait a moment, then send again.';
        return;
      }
      const button = form.querySelector('button')!;
      button.disabled = true;
      status.textContent = 'Sending.';
      try {
        const { 'cf-turnstile-response': _widget, ...values } = Object.fromEntries(new FormData(form));
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...values, token }),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        status.textContent = 'Your message has been sent.';
      } catch (failure) {
        status.textContent =
          failure instanceof Error && failure.message === '403'
            ? 'The spam check did not pass. What you wrote is still in the form. Send it again.'
            : 'The message was not sent. What you wrote is still in the form. Try again in a few minutes.';
      } finally {
        token = '';
        if (widgetId) turnstile()?.reset(widgetId);
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .form,
  .closed {
    max-width: 36rem;
  }

  .field {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    font: var(--weight-display) var(--text-h3) / 1.2 var(--font-family-display);
    color: var(--color-fg);
  }

  .hint {
    margin: 0.25rem 0 0;
    color: var(--site-text-dim);
  }

  /* 16px and up, so a phone does not zoom the page when a field takes focus. */
  input,
  textarea {
    display: block;
    width: 100%;
    min-height: var(--tap);
    margin-top: 0.5rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid rgb(232 238 255 / 0.45);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--color-fg);
    font: var(--weight-small) 1.125rem / 1.5 var(--font-body);
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  [aria-invalid='true'] {
    border-color: #ff9d8a;
  }

  .error {
    margin: 0.4rem 0 0;
    color: #ffb4a6;
  }

  .summary {
    margin-bottom: 1.5rem;
    padding: 1rem;
    border: 1px solid #ff9d8a;
    border-radius: 0.25rem;
  }

  .summary :global(p) {
    margin: 0 0 0.25rem;
    color: var(--color-fg);
  }

  .summary :global(a) {
    display: block;
    padding-block: 0.5rem;
    color: #ffb4a6;
  }

  /* The widget is 65px tall; the space is kept so it does not push the button down when it appears. */
  .check {
    min-height: 65px;
    margin-bottom: 1.5rem;
  }

  .leave {
    position: absolute;
    left: -100vw;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .note {
    max-width: none;
    color: var(--site-text-dim);
  }

  .status {
    min-height: 1.6em;
    margin: 0.75rem 0 0;
    color: var(--color-fg);
  }

  .lead {
    font: var(--weight-display) var(--text-ring-big) / var(--leading-display) var(--font-family-display);
    color: var(--color-fg);
    margin-bottom: 0.45em;
  }

  .closed .note {
    margin-top: 1.5rem;
  }
</style>
