---
import ViewLink from './ViewLink.astro';
import Shot from './Shot.astro';
import ShotCaption from './ShotCaption.astro';
import { appLink } from '../data/appLink';
import { HOME_LINKS } from '../data/homeLinks';
---

<section class="tour">
  <Shot id="tour-cosmic-web" sizes="100vw" />
  <div class="over">
    <h2>Take the tour</h2>
    <p>
      The Long Way Out is a captioned tour in 14 steps, from the Milky Way to the edge of the observable universe
      and back. Some of the light you see on the way set out before our species existed. The tour is shorter, at
      about five minutes.
    </p>
    <ViewLink hang href={appLink(HOME_LINKS.tour)}>Start the tour</ViewLink>
    <ShotCaption id="tour-cosmic-web" open={false} />
  </div>
</section>

<style>
  .tour {
    position: relative;
    margin-top: var(--section-space);
    overflow-x: clip;
    background: #000;
  }

  .tour :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    max-height: 80svh;
    object-fit: cover;
  }

  /* The frame is black where the words sit; the scrim only softens the web's lower edge behind them. */
  .tour::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(20deg, rgb(0 0 0 / 0.94) 0%, rgb(0 0 0 / 0.78) 30%, rgb(0 0 0 / 0) 58%);
  }

  /* The words keep their column; the picture's label runs along its foot, as in a PictureBand. */
  .over {
    position: absolute;
    z-index: 2;
    inset: auto max(var(--gutter), (100% - var(--wrap-max)) / 2 + var(--gutter)) 2rem;
    display: flex;
    flex-direction: column;
  }

  .over > :global(a) {
    align-self: flex-start;
  }

  .over > :global(*) {
    max-width: 28rem;
  }

  .over > :global(.caption) {
    --caption-foot: '';
    max-width: none;
    padding-top: 4rem;
  }

  .over :global(.ring) {
    margin-top: -0.5rem;
  }

  @media (max-width: 900px) {
    .tour::after {
      display: none;
    }

    .tour :global(img) {
      aspect-ratio: 4 / 3;
      object-position: 35% 50%;
    }

    .over {
      position: static;
      padding: 0 var(--gutter);
    }

    .over > :global(.caption) {
      --caption-foot: none;
      order: -1;
      margin-bottom: 2rem;
      padding-top: 0.75rem;
    }
  }
</style>
