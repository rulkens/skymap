---
import { Picture } from 'astro:assets';

import ObjLink from './ObjLink.astro';
// PLACEHOLDER SLOT (tour-image): the flight's Local Group still stands in until a frame from the tour itself is shot.
import tourStill from '../assets/flight/local-group-landscape.avif';
import { appLink } from '../data/appLink';
import { HOME_LINKS } from '../data/homeLinks';
---

<section class="tour">
  <Picture
    src={tourStill}
    alt="The Local Group and nearby galaxy groups in skymap: translucent spheres mark the groups among catalogued galaxies."
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="over">
    <h2>Take the tour</h2>
    <p>The Long Way Out is a captioned flight in 14 steps, from the Milky Way to the edge of the observable universe and back.</p>
    <ObjLink href={appLink(HOME_LINKS.tour)}>Start the tour</ObjLink>
  </div>
</section>

<style>
  .tour {
    position: relative;
    margin-top: var(--section-space);
    background: #000;
  }

  .tour :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    max-height: 80svh;
    object-fit: cover;
  }

  /* Local scrim: the left third, where the words are. */
  .tour::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.5) 38%, rgb(0 0 0 / 0) 62%);
  }

  .over {
    position: absolute;
    z-index: 2;
    left: max(var(--gutter), (100% - var(--wrap-max)) / 2 + var(--gutter));
    bottom: 12%;
    max-width: 26rem;
  }

  .over :global(.ring) {
    margin-top: -0.5rem;
  }

  @media (max-width: 900px) {
    .tour::after {
      display: none;
    }

    .tour :global(img) {
      aspect-ratio: 4 / 3;
    }

    .over {
      position: static;
      padding: 1.5rem var(--gutter) 0;
    }
  }
</style>
