---
/*
 * Columns — its children side by side in equal columns when wide, stacked when
 * narrow. Each child is one column: a heading and what belongs under it.
 * As many columns as fit at 18rem each, unless `count` fixes their number:
 * those stack at the 900px breakpoint.
 */
type Props = { count?: 2 | 3 };

const { count } = Astro.props;
---

<div class:list={['columns', { fixed: count }]} style={count && `--count:${count}`}>
  <slot />
</div>

<style>
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 2.5rem 3.75rem;
  }

  .fixed {
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
  }

  .columns > :global(*) {
    min-width: 0;
  }

  .columns :global(h3) {
    font-size: var(--text-lead);
  }

  .columns :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .fixed {
      grid-template-columns: 1fr;
    }
  }
</style>
