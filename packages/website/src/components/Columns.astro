---
/*
 * Columns — its children side by side in equal columns when wide, stacked when
 * narrow. Each child is one column: a heading and what belongs under it.
 */
---

<div class="columns">
  <slot />
</div>

<style>
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 2.5rem 3.75rem;
  }

  .columns > :global(*) {
    min-width: 0;
  }

  .columns :global(h3) {
    font-size: var(--text-lead);
  }

  .columns :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
