---
/*
 * DocFigure — `<Figure id="…" />` on a docs page: a picture from the shot
 * manifest with its label and "Open this view". A picture of the app's
 * interface runs past the text column to the page's right edge, nine columns,
 * label and all, so its text can be read (utils/docFigureWide.ts).
 * A phone gets the manifest's `<id>-phone` row where there is one, edge to
 * edge either way. The picture is a link to its largest file, which
 * FigureSheet opens over the page; "Enlarge" under it says so in words.
 * `eager` is for the one picture a page opens on, before its first heading.
 */
import Shot from './Shot.astro';
import ShotCaption from './ShotCaption.astro';
import { siteShot } from '../data/siteShot';
import { SITE_SHOTS } from '../data/siteShots';
import { docFigureWide } from '../utils/docFigureWide';
import { shotSources } from '../utils/shotSources';

type Props = { id: string; eager?: boolean };

const { id, eager = false } = Astro.props;
const shot = siteShot(id);
const wide = docFigureWide(shot);
const phone = SITE_SHOTS.find((row) => row.id === `${id}-phone`)?.id;
const { full, width, height } = shotSources(id);
// The picture's box at each layout of layouts/Docs.astro: nine columns of the page grid, or the text's seven and then six.
const sizes = wide
  ? '(max-width: 900px) 100vw, (max-width: 1239px) calc(75vw - 4.875rem), 53.25rem'
  : '(max-width: 900px) 100vw, (max-width: 1199px) calc(58.33vw - 4.46rem), (max-width: 1239px) calc(50vw - 4.25rem), 34.5rem';
const sheet = {
  href: full,
  'data-enlarge': shot.title,
  'data-width': width,
  'data-height': height,
  'data-file-width': Math.max(...shot.widths),
};
---

<figure class:list={{ wide }} data-embed>
  <!-- Out of the keyboard's path: "Enlarge" below is the same link with words a reader can see. -->
  <a class="picture" tabindex="-1" {...sheet}>
    <Shot id={id} tall={phone} sizes={sizes} eager={eager} />
    <span class="unseen" data-pagefind-ignore>Open this picture larger</span>
  </a>
  <figcaption>
    <ShotCaption id={id} />
    <a class="ring small enlarge" data-pagefind-ignore {...sheet}>Enlarge</a>
  </figcaption>
</figure>

<style>
  .picture {
    display: block;
    cursor: zoom-in;
  }

  .picture :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    position: relative;
    margin-top: 0.5rem;
  }

  /* On the label's last line, where "Open this view" stands, at the other end of it. */
  .enlarge {
    position: absolute;
    right: 0;
    bottom: 0;
    color: var(--site-text-dim);
  }

  /* Narrow, the picture runs to the screen's edges; its label keeps the text edge. */
  @media (max-width: 900px) {
    .picture {
      margin-inline: calc(-1 * var(--gutter));
    }
  }

  /*
   * Wide: the figure runs out to the right by the page grid's columns the text does not use (twelve less the
   * contents' three and the text's own), so its right edge is the page's, and its label lies along its foot on
   * those nine columns.
   */
  @media (min-width: 901px) {
    .wide {
      --figure-out: calc((var(--cols) - 9) * ((100% - (var(--cols) - 1) * var(--col-gap)) / var(--cols) + var(--col-gap)));
    }

    .wide figcaption {
      --cols: 9;
    }
  }

  /*
   * The page's own headings stand still in those columns (layouts/Docs.astro), and a wide figure passes in front
   * of them: black from its top to its foot, fading in over the gap above it and out over the gap below, so the
   * list dims as the picture nears and nothing is switched.
   */
  @media (min-width: 1200px) {
    .wide {
      position: relative;
      z-index: 1;
    }

    .wide::before {
      content: '';
      position: absolute;
      z-index: -1;
      inset: -2.5rem 0;
      background: linear-gradient(
        rgb(0 0 0 / 0),
        var(--color-bg) 2.5rem,
        var(--color-bg) calc(100% - 2.5rem),
        rgb(0 0 0 / 0)
      );
    }
  }
</style>
