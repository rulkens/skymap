---
/*
 * ShotCaption — a picture's label, set as a museum sets an object's: a rule
 * with an arm that rises to the picture, the title, one sentence, then what is
 * data and what is drawn, the credit for third-party imagery in frame, and the
 * address the picture was taken at. Every picture being an address is the
 * site's honesty device. It is set quietly, as a caption: nothing in it is
 * brighter than the page's body text. It lays itself out by the room it is
 * given: stacked under a narrow picture, in columns along the foot of a wide one.
 */
import ViewLink from './ViewLink.astro';
import { appLink } from '../data/appLink';
import { siteShot } from '../data/siteShot';

type Props = { id: string; open?: boolean };

const { id, open = true } = Astro.props;
const shot = siteShot(id);
---

<div class="caption small">
  <div class="plate">
    <p class="what">
      <strong>{shot.title}</strong>
      {shot.caption && <span>{shot.caption}</span>}
    </p>
    {
      shot.drawn && (
        <dl class="drawn">
          <dt>Data and drawing</dt>
          <dd>{shot.drawn}</dd>
        </dl>
      )
    }
    {
      (shot.credit || open) && (
        <div class="end">
          {shot.credit && (
            <dl>
              <dt>Credit</dt>
              <dd>{shot.credit}.</dd>
            </dl>
          )}
          {open &&
            (shot.link.startsWith('tour=') ? (
              <ViewLink href={appLink(shot.link, shot.query)}>Start the tour</ViewLink>
            ) : (
              <ViewLink href={appLink(shot.link, shot.query)} />
            ))}
        </div>
      )
    }
  </div>
</div>

<style>
  .caption {
    position: relative;
    z-index: 0;
    container-type: inline-size;
    width: 100%;
    margin: 0;
    text-align: left;
  }

  /* The rule is as faint as the page's dividers; the label stands where its picture has faded to black. */
  .plate {
    --rule: rgb(232 238 255 / 0.2);
    position: relative;
    display: grid;
    gap: 0.375rem 2.5rem;
    max-width: 34rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--rule);
    line-height: 1.4;
  }

  /* The arm: the rule turns up at its left end and reaches for the picture above it. */
  .plate::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 100%;
    height: 0.5rem;
    border-left: 1px solid var(--rule);
  }

  p,
  dl,
  dd {
    max-width: none;
    margin: 0;
  }

  strong {
    display: block;
    font-weight: inherit;
    color: var(--site-text-muted);
  }

  .what,
  dd {
    color: var(--site-text-dim);
  }

  dt {
    color: var(--site-text-faint);
  }

  /* The control keeps its 44px for the thumb; the margin takes back what the row of text does not need. */
  .end :global(.ring) {
    margin-block: 0 -0.625rem;
  }

  /*
   * In columns, the label takes the page grid's: `--cols` is how many of them its place spans (styles/site.css),
   * and the title has five twelfths of those, to the nearest line.
   */
  @container (min-width: 34rem) {
    .plate {
      --what: calc(var(--cols, 12) * 5 / 12);
      grid-template-columns: repeat(var(--cols, 12), minmax(0, 1fr));
      column-gap: var(--col-gap);
      max-width: none;
    }

    .what {
      grid-area: 1 / 1 / span 2 / span var(--what);
    }

    .drawn,
    .end {
      grid-column: calc(var(--what) + 1) / -1;
    }
  }

  @container (min-width: 58rem) {
    .what {
      grid-area: auto / 1 / auto / span 4;
    }

    .drawn {
      grid-column: 5 / span 5;
    }

    .end {
      grid-column: 10 / -1;
    }
  }
</style>
