---
/*
 * Sources — the page's numbered source list, generated from the fact ids it
 * used. Closed by default: sixteen entries are two phone screens, and the
 * count in the summary says they are there. Only science claims are listed;
 * `all` lists statements about the app too, for the Privacy page.
 */
import { fact } from '../data/fact';
import { formatDate } from '../utils/formatDate';
import { listedSources } from '../utils/listedSources';

type Props = { ids: readonly string[]; label?: string; all?: boolean };

const { ids, label = 'Sources for the numbers on this page', all = false } = Astro.props;
const rows = listedSources([...new Set(ids)].map(fact), all);
---

{
  rows.length > 0 && (
    <details class="sources small">
      <summary class="ring small">{label} ({rows.length})</summary>
      <ol>
        {rows.map((row) => (
          <li>
            {row.text} <a href={row.source}>{row.sourceLabel}</a>, checked{' '}
            <span class="date">{formatDate(row.checked)}</span>.
          </li>
        ))}
      </ol>
    </details>
  )
}

<style>
  .sources {
    padding-block: 1rem;
    border-top: 1px solid var(--border-divider);
    color: var(--site-text-dim);
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  ol {
    max-width: 62rem;
    margin: 0.5rem 0 1rem;
    padding-left: 1.5rem;
  }

  li {
    padding-block: 0.25rem;
  }
</style>
