---
/*
 * Disc — a fisheye frame from the app's dome mode, shown round with a ring
 * about it. The frame is a disc inscribed
 * in a square, so the round mask trims only its black corners. It is as wide
 * as the box it is put in; the ring stands `--disc-ring` outside that, which the
 * host leaves room for.
 */
import Shot from './Shot.astro';

type Props = { id: string; sizes: string; eager?: boolean };

const { id, sizes, eager = false } = Astro.props;
---

<div class="disc">
  <Shot id={id} sizes={sizes} eager={eager} />
</div>

<style>
  .disc {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgb(232 238 255 / 0.5),
      0 0 0 1.125rem #000,
      0 0 0 var(--disc-ring) rgb(232 238 255 / 0.18);
  }

  .disc :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
