---
/* FactText — `<Fact id="…" />` on a docs page: the words of one sourced row of data/facts.ts, as a paragraph or, with `inline`, inside a sentence. A command-line flag in the words is set as code (utils/flagParts.ts). The page's source list finds the id in the text (pages/docs/[...slug].astro). */
import { fact } from '../data/fact';
import { flagParts } from '../utils/flagParts';

type Props = { id: string; inline?: boolean };

const { id, inline = false } = Astro.props;
const parts = flagParts(fact(id).text);
const Tag = inline ? Fragment : 'p';
---

<Tag>{parts.map((part) => (part.flag ? <code>{part.text}</code> : part.text))}</Tag>
