---
import ObjLink from './ObjLink.astro';
import pkg from '../../../../package.json';
import { FOOTER_ITEMS } from '../data/nav';
import { MAKER_NAME, REPO_BLOB, REPO_URL } from '../data/siteIdentity';
import { sitePath } from '../utils/sitePath';
---

<footer class="wrap footer small">
  <p>
    skymap is made by {MAKER_NAME}. The code is open source under the <a href={`${REPO_BLOB}/LICENSE`}>{pkg.license} licence</a>.
    Version {pkg.version}.
  </p>
  <nav aria-label="Footer">
    {FOOTER_ITEMS.map((item) => <ObjLink size="small" href={sitePath(item.path)}>{item.label}</ObjLink>)}
    <ObjLink size="small" href={REPO_URL}>GitHub</ObjLink>
  </nav>
</footer>

<style>
  .footer {
    padding-block: 2rem 4rem;
    border-top: 1px solid var(--border-divider);
    color: var(--site-text-dim);
  }

  p {
    max-width: none;
    margin: 0 0 0.5rem;
    color: inherit;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
  }
</style>
