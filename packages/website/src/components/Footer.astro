---
import ObjLink from './ObjLink.astro';
import pkg from '../../../../package.json';
import { FOOTER_ITEMS } from '../data/nav';
import { MAKER_NAME, REPO_URL } from '../data/siteIdentity';
import { sitePath } from '../utils/sitePath';
---

<footer class="wrap footer">
  <p>skymap is made by {MAKER_NAME}. The code is open source. Version {pkg.version}.</p>
  {FOOTER_ITEMS.map((item) => <ObjLink size="small" href={sitePath(item.path)}>{item.label}</ObjLink>)}
  <ObjLink size="small" href={REPO_URL}>GitHub</ObjLink>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.875rem 2.125rem;
    padding-block: 3rem 5.5rem;
    border-top: 1px solid var(--border-divider);
    font-size: var(--text-small);
    color: var(--site-text-dim);
  }

  p {
    margin: 0 auto 0 0;
    max-width: none;
    color: inherit;
  }
</style>
