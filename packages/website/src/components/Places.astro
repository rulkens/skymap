---
import { appLink } from '../data/appLink';
import { fact } from '../data/fact';
import { PLACES } from '../data/places';
---

<section class="wrap places" id="places">
  <div class="head">
    <h2>Pick somewhere to start</h2>
    <p>Nine places, nearest first. A light-second is how far light goes in one second.</p>
  </div>
  <ul class="things">
    {
      PLACES.map((place) => (
        <li>
          <a class="thing" href={appLink(place.hash)}>
            <span class="disc">
              <img src={place.image} width="204" height="204" alt="" loading="lazy" decoding="async" />
            </span>
            <b>{place.name}</b>
            {place.factId && <span class="far">{fact(place.factId).short}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .places {
    padding-block: 6rem var(--section-space);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-bottom: 4rem;
  }

  .head h2,
  .head p {
    margin: 0;
  }

  .things {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .things li {
    width: calc((100% - 4 * 1.5rem) / 5);
  }

  .things li:nth-child(even) {
    transform: translateY(2.875rem);
  }

  .thing {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
  }

  .disc {
    display: block;
    width: 100%;
    max-width: 10.5rem;
    aspect-ratio: 1;
    padding: 0.5625rem;
    border: 1px solid rgb(168 208 255 / 0.45);
    border-radius: 50%;
    transition:
      padding 0.3s ease,
      border-color 0.3s ease;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .thing:hover .disc,
  .thing:focus-visible .disc {
    padding: 0.125rem;
    border-color: var(--color-accent);
  }

  .thing:focus-visible {
    outline: none;
  }

  .thing:focus-visible .disc {
    outline: 1px solid var(--color-accent);
    outline-offset: 5px;
  }

  b {
    margin-top: 1rem;
    font: var(--weight-display) 1.4375rem / 1.1 var(--font-family-display);
    color: var(--color-fg);
  }

  .far {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--site-text-dim);
  }

  @media (max-width: 900px) {
    .things li {
      width: calc((100% - 1.5rem) / 2);
    }

    .things li:nth-child(even) {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .disc {
      transition: none;
    }
  }
</style>
