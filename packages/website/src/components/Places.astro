---
/*
 * Places — nine places to start from, each a whole-row link: its picture in a
 * disc, its name and how far away it is. A card has no margin to hang the
 * launch drawing in, so it follows the name. The one view link that is not a
 * ViewLink, because the picture is part of the target.
 */
import { appLink } from '../data/appLink';
import { fact } from '../data/fact';
import { PLACES } from '../data/places';
import Icon from './Icon.astro';
import Shot from './Shot.astro';
---

<section class="wrap places" id="places">
  <div class="head">
    <h2>Pick somewhere to start</h2>
    <p>Nine places, nearest first. A light-second is how far light goes in one second.</p>
  </div>
  <ol class="things">
    {
      PLACES.map((place) => (
        <li>
          <a class="thing" href={appLink(place.hash)}>
            <span class="disc">
              <Shot id={place.shot} sizes="(min-width: 900px) 7.5rem, 5rem" alt="" />
            </span>
            <span class="text">
              <b>
                {place.name}
                <Icon name="launch" />
              </b>
              <span class="far small">{place.factId ? fact(place.factId).short : place.note}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* Half a section gap: this continues the lead above it. */
  .places {
    padding-top: calc(var(--section-space) / 2);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 3rem;
  }

  .head h2,
  .head p {
    margin: 0;
  }

  /* Phone: a list, one place a row, the whole row the target. */
  .things {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thing {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.75rem;
    text-decoration: none;
  }

  .disc {
    flex: none;
    display: block;
    width: 5rem;
    aspect-ratio: 1;
    padding: 0.3125rem;
    border: 1px solid rgb(168 208 255 / 0.45);
    border-radius: 50%;
    transition:
      padding 0.3s ease,
      border-color 0.3s ease;
  }

  .disc :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .thing:hover .disc,
  .thing:focus-visible .disc {
    padding: 0.125rem;
    border-color: var(--color-accent);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  b {
    font: var(--weight-display) var(--text-h3) / 1.1 var(--font-family-display);
    color: var(--color-fg);
  }

  b :global(.glyph) {
    width: 1.25rem;
    height: 1.25rem;
    margin-left: 0.375rem;
    stroke: var(--color-accent);
  }

  .far {
    line-height: 1.3;
    color: var(--site-text-dim);
  }

  /* Wide: the same rows, three by three, still read nearest first. */
  @media (min-width: 900px) {
    .things {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem clamp(1.5rem, 3vw, 3rem);
    }

    .disc {
      width: clamp(5rem, 8vw, 7.5rem);
      padding: 0.4375rem;
    }

    .thing {
      gap: clamp(1rem, 2vw, 1.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .disc {
      transition: none;
    }
  }
</style>
