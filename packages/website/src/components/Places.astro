---
/*
 * Places — nine places to start from, nearest first, hung on one hairline
 * that runs out from Earth: each a disc that grows with its distance, its name
 * and how far away it is. Disc, name and distance are one link (the one view
 * link that is not a ViewLink, because the picture is part of the target), so
 * the view mark follows the name. Pointed at or focused, a disc gets the
 * ring of the site drawn round it and plays its film (scripts/initPlaceFilms.ts),
 * with a mark going round the ring once per loop. Scrolling draws the line
 * and drifts the discs a few pixels at different depths (scripts/initPlaceDrift.ts).
 *
 * Every position and size is in units of the width of the field (cqw), so the
 * composition scales as one drawing and the line, an SVG in the same units,
 * always passes through the disc centres. Two compositions: `TALL` zigzags
 * down an upright screen, `WIDE` wanders across a wide one.
 */
import { appLink } from '../data/appLink';
import { fact } from '../data/fact';
import { PLACES } from '../data/places';
import { loopUrl } from '../utils/loopUrl';
import { smoothPath } from '../utils/smoothPath';
import Icon from './Icon.astro';
import Shot from './Shot.astro';

// Disc diameters, nearest first, in units of a field 100 wide.
const TALL_SIZES = [30, 32, 34, 36, 38, 41, 44, 47, 52];
// How far a disc stands in from its edge of the field, so the zigzag is not ruled.
const TALL_INSET = [0, 3, 5, 0, 0, 0, 2, 3, 0];
// Room between a disc and the one before it, on top of half their radii: the height of the labels that meet there.
const TALL_STEP = [0, 19, 19, 19, 21, 28, 25, 21, 22];
const TALL_GAP = 5;

// Multiplied, not divided: a slash after `!` reads as the start of a pattern to `astro check`.
let tallY = TALL_SIZES[0]! * 0.5;
const tall = TALL_SIZES.map((d, i) => {
  if (i > 0) tallY += (TALL_SIZES[i - 1]! + d) * 0.25 + TALL_STEP[i]!;
  const left = i % 2 === 0;
  const x = left ? TALL_INSET[i]! + d * 0.5 : 100 - TALL_INSET[i]! - d * 0.5;
  return { x, y: tallY, d, side: left ? 'left' : 'right', room: 100 - d - TALL_INSET[i]! - TALL_GAP };
});
const tallHeight = tallY + TALL_SIZES.at(-1)! * 0.5;

// Centre x, centre y and diameter in units of a field 1000 wide. The upper row carries its labels above and
// the lower row below, so the line between the rows never crosses a word; `hang` is how a label sits on its disc.
const WIDE_HEIGHT = 655;
const wide = [
  { x: 42, y: 201, d: 84, row: 'upper', hang: 'start' },
  { x: 146, y: 417, d: 92, row: 'lower', hang: 'center' },
  { x: 250, y: 137, d: 102, row: 'upper', hang: 'center' },
  { x: 356, y: 461, d: 112, row: 'lower', hang: 'center' },
  { x: 462, y: 179, d: 124, row: 'upper', hang: 'center' },
  { x: 572, y: 427, d: 136, row: 'lower', hang: 'center' },
  { x: 682, y: 151, d: 150, row: 'upper', hang: 'center' },
  { x: 796, y: 465, d: 164, row: 'lower', hang: 'center' },
  { x: 908, y: 197, d: 184, row: 'upper', hang: 'end' },
];

// How many pixels each disc drifts, up or down, while the field crosses the screen.
const DEPTHS = [-8, 12, -16, 9, -13, 18, -9, 14, -18];

// The view mark stays on the line of the last word of the name.
const places = PLACES.map((place, i) => {
  const words = place.name.split(' ');
  const name = { head: words.slice(0, -1).join(' '), last: words.at(-1)! };
  const film = place.loop ? loopUrl(place.loop) : undefined;
  return { place, name, film, tall: tall[i]!, wide: wide[i]!, depth: DEPTHS[i]! };
});
const vars = (p: (typeof places)[number]) =>
  `--tx:${p.tall.x};--ty:${p.tall.y.toFixed(2)};--td:${p.tall.d};--room:${p.tall.room};` +
  `--wx:${p.wide.x};--wy:${p.wide.y};--wd:${p.wide.d};--depth:${p.depth}`;
---

<section class="wrap places" id="places">
  <div class="head">
    <h2>Pick somewhere to start</h2>
    <p>Nine places, nearest first. A light-second is how far light goes in one second.</p>
  </div>
  <div class="field" data-field style={`--tall-height:${tallHeight.toFixed(2)};--wide-height:${WIDE_HEIGHT}`}>
    <svg class="thread tall" viewBox={`0 0 100 ${tallHeight.toFixed(2)}`} aria-hidden="true">
      <path d={smoothPath(tall.map((p) => [p.x, p.y]), 0.9)} pathLength="1"></path>
    </svg>
    <svg class="thread wide" viewBox={`0 0 1000 ${WIDE_HEIGHT}`} aria-hidden="true">
      <path d={smoothPath(wide.map((p) => [p.x, p.y]), 0.9)} pathLength="1"></path>
    </svg>
    <ol>
      {
        places.map((p) => (
          <li style={vars(p)} data-side={p.tall.side} data-hang={p.wide.hang} data-row={p.wide.row}>
            <a class="thing" href={appLink(p.place.hash)} data-film-src={p.film}>
              <span class="disc">
                <span class="screen" data-screen>
                  <Shot id={p.place.shot} sizes="(min-width: 901px) 15vw, 45vw" alt="" />
                </span>
                <svg class="orbit" aria-hidden="true">
                  <circle cx="50%" cy="50%" r="50%"></circle>
                </svg>
                <i class="mark"></i>
              </span>
              <span class="text">
                <b>
                  {p.name.head}{' '}
                  <span class="last">
                    {p.name.last}
                    <Icon name="view" />
                  </span>
                </b>
                <span class="far small">{p.place.factId ? fact(p.place.factId).short : p.place.note}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { initPlaceDrift } from '../scripts/initPlaceDrift';
  import { initPlaceFilms } from '../scripts/initPlaceFilms';

  const places = document.querySelector<HTMLElement>('#places');
  const field = places?.querySelector<HTMLElement>('[data-field]');
  if (places) initPlaceFilms(places);
  if (field) initPlaceDrift(field);
</script>

<style>
  /* Half a section gap: this continues the lead above it. */
  .places {
    padding-top: calc(var(--section-space) / 2);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }

  .head h2,
  .head p {
    margin: 0;
  }

  .field {
    --hairline: rgb(168 208 255 / 0.3);
    position: relative;
    container-type: inline-size;
    /* A tablet held upright keeps the phone's composition at a phone's size. */
    max-width: 30rem;
    aspect-ratio: 100 / var(--tall-height);
  }

  .thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  /* Drawn out from Earth as far as the scroll has come (`--drawn`); whole without script. */
  .thread path {
    fill: none;
    stroke: var(--hairline);
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--drawn, 1));
  }

  /* Stroke widths are in each drawing's own units and come to about a pixel. */
  .thread.tall path {
    stroke-width: 0.28;
  }

  .thread.wide path {
    stroke-width: 0.9;
  }

  .thread.wide {
    display: none;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    --u: 1cqw;
    --x: var(--tx);
    --y: var(--ty);
    --d: var(--td);
    position: absolute;
    left: calc((var(--x) - var(--d) / 2) * var(--u));
    top: calc((var(--y) - var(--d) / 2) * var(--u));
    width: calc(var(--d) * var(--u));
    transform: translate3d(0, calc(var(--drift, 0) * var(--depth) * 1px), 0);
  }

  .thing {
    display: block;
    text-decoration: none;
  }

  /* The ground colour behind the picture hides the line where it passes under a disc. */
  .disc {
    position: relative;
    display: block;
    aspect-ratio: 1;
    padding: 6%;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: var(--color-bg);
  }

  .screen {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: 50%;
  }

  .screen :global(img),
  .screen :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The film lies over its own first frame and appears once it is playing. */
  .screen :global(video) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  [data-film] .screen :global(video) {
    opacity: 1;
  }

  /*
   * The site's ring, drawn round the disc from the top when it is pointed at,
   * focused or playing; it lies exactly over the resting border.
   */
  .orbit,
  .mark {
    position: absolute;
    inset: -1px;
    pointer-events: none;
  }

  .orbit {
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    overflow: visible;
    transform: rotate(-90deg);
  }

  /* No viewBox, so the dash is in pixels: a little over the circumference of a disc `--d` units across. */
  .orbit circle {
    --round: calc(3.2 * var(--d) * var(--u));
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-dasharray: var(--round);
    stroke-dashoffset: var(--round);
    transition: stroke-dashoffset 0.9s cubic-bezier(0.3, 0, 0.2, 1);
  }

  .thing:hover .orbit circle,
  .thing:focus-visible .orbit circle,
  [data-playing] .orbit circle {
    stroke-dashoffset: 0;
  }

  /* A small body on that ring: once round for each loop of the film. */
  .mark {
    transform: rotate(calc(var(--turn, 0) * 1turn));
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .mark::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 0.4375rem;
    height: 0.4375rem;
    margin: -0.21875rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 0.1875rem var(--color-bg);
  }

  [data-playing][data-film] .mark {
    opacity: 1;
  }

  /* The label is outside the link's box, so the focus ring goes round the disc. */
  .thing:focus-visible {
    outline: none;
  }

  .thing:focus-visible .disc {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }

  /*
   * The label hangs off the disc on a short tick, as a label is pinned to its
   * object in the app. Its padding spans the gap, so the pointer stays on the
   * link all the way from picture to words.
   */
  .text {
    --gap: calc(var(--tall-gap, 5) * var(--u));
    position: absolute;
    top: 50%;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    width: calc((var(--room) + 5) * var(--u));
    transform: translateY(-50%);
  }

  .text::before {
    content: '';
    position: absolute;
    top: 50%;
    width: calc(var(--gap) - 0.5rem);
    border-top: 1px solid var(--hairline);
  }

  [data-side='left'] .text {
    left: 100%;
    padding-left: var(--gap);
  }

  [data-side='left'] .text::before {
    left: 0;
  }

  [data-side='right'] .text {
    right: 100%;
    padding-right: var(--gap);
    text-align: right;
  }

  [data-side='right'] .text::before {
    right: 0;
  }

  b {
    font: var(--weight-display) var(--text-h3) / 1.1 var(--font-family-display);
    color: var(--color-fg);
  }

  .last {
    white-space: nowrap;
  }

  /* The view mark at the size and dimness it has under every picture; pointing at the place lights it. */
  b :global(.glyph) {
    width: 1rem;
    height: 1rem;
    margin-left: 0.25rem;
    stroke: var(--site-text-dim);
    transition: stroke 0.25s ease;
  }

  .thing:hover b :global(.glyph),
  .thing:focus-visible b :global(.glyph) {
    stroke: var(--color-accent);
  }

  .far {
    line-height: 1.3;
    color: var(--site-text-dim);
  }

  @media (min-width: 901px) {
    .field {
      max-width: none;
      aspect-ratio: 1000 / var(--wide-height);
    }

    .thread.tall {
      display: none;
    }

    .thread.wide {
      display: block;
    }

    li {
      --u: 0.1cqw;
      --x: var(--wx);
      --y: var(--wy);
      --d: var(--wd);
    }

    li[data-row] .text {
      --gap: 1.5rem;
      /* Under the pitch of the upper row (about 210 units), so neighbouring labels never meet. */
      --width: calc(196 * var(--u));
      top: 100%;
      right: auto;
      left: calc(50% - var(--width) / 2);
      width: var(--width);
      padding: var(--gap) 0 0;
      text-align: center;
      transform: none;
    }

    li[data-row='upper'] .text {
      top: auto;
      bottom: 100%;
      padding: 0 0 var(--gap);
    }

    li[data-row] .text::before {
      top: 0.375rem;
      right: auto;
      left: 50%;
      width: 0;
      height: calc(var(--gap) - 0.75rem);
      border-top: 0;
      border-left: 1px solid var(--hairline);
    }

    li[data-row='upper'] .text::before {
      top: auto;
      bottom: 0.375rem;
    }

    /* At the field's two ends the label keeps to the column edge the disc sits on. */
    li[data-row][data-hang='start'] .text {
      left: 0;
      text-align: left;
    }

    li[data-row][data-hang='end'] .text {
      right: 0;
      left: auto;
      text-align: right;
    }

    li[data-row][data-hang='start'] .text::before {
      left: calc(var(--d) * var(--u) / 2);
    }

    li[data-row][data-hang='end'] .text::before {
      right: calc(var(--d) * var(--u) / 2);
      left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit circle {
      transition: none;
    }
  }
</style>
