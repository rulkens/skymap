---
/*
 * ViewStack — one child per view of a gallery band (PictureBand with `views`),
 * in the views' order. They share one cell, so the tallest reserves the room
 * and nothing moves when the view changes; only the current one shows.
 */
---

<div class="stack" data-views>
  <slot />
</div>

<style>
  .stack {
    --view-out: 0.3s;
    --view-wait: 0.3s;
    --view-in: 0.6s;
    display: grid;
    align-items: start;
  }

  .stack > :global(*) {
    grid-area: 1 / 1;
    min-width: 0;
  }
</style>
