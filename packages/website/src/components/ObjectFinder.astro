---
/*
 * ObjectFinder — the head of the object catalogue: a field that narrows every
 * ObjectList on the page as you type, and the sections with their counts as a
 * jump list (a phone has no "On this page"). The field is shown by the script
 * that makes it work (scripts/initObjectFinder.ts), so without script the page
 * is the jump list and the plain lists.
 */
import { OBJECT_ROWS, OBJECT_SECTIONS } from '../data/objectCatalogue';
import { objectSectionRows } from '../utils/objectSectionRows';

const counted = OBJECT_SECTIONS.map((section) => ({
  ...section,
  count: objectSectionRows(section, OBJECT_ROWS).length,
}));
---

<div class="finder" data-object-finder data-pagefind-ignore>
  <p class="field" hidden>
    <label class="small" for="object-filter">Narrow the list</label>
    <input
      id="object-filter"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="A name, another name or an id"
    />
    <span class="small" role="status"></span>
  </p>
  <ul class="kinds small">
    {
      counted.map((section) => (
        <li>
          <a href={`#${section.id}`}>{section.title}</a> <span>{section.count}</span>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { initObjectFinder } from '../scripts/initObjectFinder';

  const finder = document.querySelector<HTMLElement>('[data-object-finder]');
  if (finder) initObjectFinder(finder);
</script>

<style>
  /* No box of its own, so the field is held by the whole text and can stay in sight to the end of the lists. */
  .finder {
    display: contents;
  }

  /* The field stays under the bars while the list scrolls, so the words typed can be changed from any row. */
  .field {
    position: sticky;
    top: calc(var(--nav-height) + var(--docs-bar));
    z-index: 2;
    display: grid;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
    padding-top: 0.5rem;
    background: var(--color-bg);
  }

  /* Each has a display of its own above, which would show it while it is hidden. */
  .field[hidden],
  .finder .kinds[hidden] {
    display: none;
  }

  label,
  [role='status'] {
    color: var(--site-text-dim);
  }

  [role='status'] {
    min-height: 1.5em;
  }

  input {
    width: 100%;
    min-height: var(--tap);
    padding: 0 0 0.25rem;
    border: 0;
    border-bottom: 1px solid var(--site-text-dim);
    border-radius: 0;
    background: none;
    color: var(--color-fg);
    font: var(--weight-small) var(--text-body) / 1.3 var(--font-body);
  }

  input:focus-visible {
    outline: 0;
    border-bottom-color: var(--color-accent);
    box-shadow: 0 1px var(--color-accent);
  }

  input::placeholder {
    color: var(--site-text-faint);
  }

  .finder .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-bottom: 2.5rem;
    padding-left: 0;
  }

  .kinds li {
    margin-block: 0;
  }

  .kinds li::before {
    content: none;
  }

  .kinds a {
    display: inline-block;
    padding-block: 0.625rem;
  }

  .kinds span {
    color: var(--site-text-dim);
  }
</style>
