---
/*
 * Citation — how to cite skymap, built from data/citation.ts (which reads
 * CITATION.cff), so a release changes it in one place. The short form is the
 * reference as a line of text with a way to the docs' Cite page; `full`, for
 * that page, adds the BibTeX entry between two rules, as the docs set code,
 * and the citation file. Each text has the copy control an address has.
 */
import CopyButton from './CopyButton.astro';
import { CITATION } from '../data/citation';
import { fact } from '../data/fact';
import { REPO_URL } from '../data/siteIdentity';
import { citationBibtex } from '../utils/citationBibtex';
import { citationText } from '../utils/citationText';
import { sitePath } from '../utils/sitePath';

type Props = { full?: boolean };

const { full = false } = Astro.props;
const doiUrl = `https://doi.org/${CITATION.versionDoi ?? CITATION.conceptDoi}`;
const text = citationText(CITATION);
const bibtex = citationBibtex(CITATION, REPO_URL);
---

<div class="citation tap-links" data-embed>
  <div class="row">
    <p class="reference small">
      {text.replace(doiUrl, '')}<a href={doiUrl}>{doiUrl}</a>
    </p>
    <CopyButton text={text} label="Copy the reference" />
  </div>
  {
    full ? (
      <>
        <div class="row">
          <pre>{bibtex}</pre>
          <CopyButton text={bibtex} label="Copy the BibTeX entry" />
        </div>
        <p class="small">
          {fact('sci-cite-file').text} <a href={fact('sci-cite-file').source}>CITATION.cff</a>
        </p>
      </>
    ) : (
      <p class="small">
        {fact('sci-cite-skymap').text} The BibTeX entry, how to cite one view, and the papers to cite for each catalogue are on{' '}
        <a href={sitePath('/docs/cite/')}>the docs’ Cite page</a>.
      </p>
    )
  }
</div>

<style>
  p {
    max-width: 60ch;
  }

  /* A text and its copy control, the control at the text's first line. */
  .row {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: var(--stack);
  }

  .row > :first-child {
    flex: 1;
    min-width: 0;
    margin-bottom: 0;
  }

  .reference {
    color: var(--site-text);
  }

  .reference a {
    overflow-wrap: anywhere;
  }

  /* The entry's long lines wrap inside the block's two rules (DocBody), so no word of it is out of sight. */
  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
