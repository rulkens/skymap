---
/*
 * FigureSheet — the sheet a docs picture opens in when it is clicked: the
 * whole window, the picture's name and Close in a bar, and under it the
 * picture as large as the window shows whole, never smaller than the app drew
 * it. A window too small for that scrolls, and a touch screen may pinch. One
 * per page, filled by scripts/initFigureSheet.ts from the picture clicked. It
 * is the search sheet's kind of dialog (DocsSearch.astro).
 */
---

<dialog class="sheet" data-figure-sheet aria-labelledby="figure-name">
  <div class="wrap bar">
    <p class="small" id="figure-name" data-figure-name></p>
    <button class="ring small" type="button">Close</button>
  </div>
  <div class="room"><img alt="" decoding="async" /></div>
</dialog>

<script>
  import { initFigureSheet } from '../scripts/initFigureSheet';

  const sheet = document.querySelector<HTMLDialogElement>('[data-figure-sheet]');
  if (sheet) initFigureSheet(sheet);
</script>

<style>
  .sheet {
    --bar: 3.75rem;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: inherit;
  }

  /* Only while open: a closed dialog given a display of its own would show. */
  .sheet[open] {
    display: grid;
    grid-template-rows: var(--bar) minmax(0, 1fr);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
  }

  .bar p {
    max-width: none;
    margin: 0;
    color: var(--site-text-dim);
  }

  .bar button {
    flex: none;
  }

  .room {
    display: flex;
    overflow: auto;
    overscroll-behavior: contain;
    cursor: zoom-out;
  }

  /*
   * As wide as the window shows the whole picture, between the size the app drew it at (`--own`) and its file's
   * pixels. The auto margin centres it and, unlike `justify-content`, leaves an overflowing picture's start in reach.
   */
  img {
    flex: none;
    width: clamp(var(--own), min(100%, (100dvh - var(--bar)) * var(--shape)), var(--file));
    max-width: none;
    height: auto;
    margin: auto;
    cursor: auto;
  }

  /* The page behind must not scroll while the sheet covers it. */
  :global(html:has(dialog[data-figure-sheet][open])) {
    overflow: hidden;
  }
</style>
