---
/*
 * FigureSheet — the sheet a docs picture opens in when it is clicked: the
 * whole window, the picture's name and Close in a bar, and under it the
 * picture as large as the window shows whole. A window narrower than the app
 * drew it shows it at the app's size, starting at its middle, and scrolls;
 * a touch screen may pinch. One per page, filled by scripts/initFigureSheet.ts from the picture clicked. It
 * is the search sheet's kind of dialog (DocsSearch.astro).
 */
---

<dialog class="sheet" data-figure-sheet aria-labelledby="figure-name">
  <div class="wrap bar">
    <p class="small" id="figure-name">
      <span data-figure-name></span>
      <span class="pan">Drag to see the rest of it.</span>
    </p>
    <button class="ring small" type="button">Close</button>
  </div>
  <div class="room"><img alt="" decoding="async" /></div>
</dialog>

<script>
  import { initFigureSheet } from '../scripts/initFigureSheet';

  const sheet = document.querySelector<HTMLDialogElement>('[data-figure-sheet]');
  if (sheet) initFigureSheet(sheet);
</script>

<style>
  .sheet {
    --bar: 3.75rem;
    inset: 0;
    height: 100dvh;
    max-height: none;
    padding: 0;
  }

  /* Only while open: a closed dialog given a display of its own would show. */
  .sheet[open] {
    display: grid;
    grid-template-rows: var(--bar) minmax(0, 1fr);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
  }

  .bar p {
    max-width: none;
    margin: 0;
    color: var(--site-text-dim);
  }

  .bar button {
    flex: none;
  }

  .room {
    display: flex;
    overflow: auto;
    overscroll-behavior: contain;
    cursor: zoom-out;
  }

  /*
   * As large as the window shows the whole picture, up to its file's pixels. The auto margin centres it and,
   * unlike `justify-content`, leaves an overflowing picture's start in reach.
   */
  img {
    flex: none;
    width: min(100%, (100dvh - var(--bar)) * var(--shape), var(--file));
    max-width: none;
    height: auto;
    margin: auto;
    cursor: auto;
  }

  /* A window narrower than the app drew the picture (`--own`) shows it at that size and pans (scripts/initFigureSheet.ts). */
  [data-pan] img {
    width: var(--own);
  }

  .pan {
    display: none;
  }

  [data-pan] .pan {
    display: inline;
  }
</style>
