---
/*
 * DocsNav — the docs' own contents, beside every docs page: the seven groups
 * of data/docsTree.ts in order, search above them. A written page is a link; a
 * planned one is its name, dimmer and inert, so the tree shows its whole shape
 * from the first page on. The page you are on carries the app's selection
 * mark, a filled point with a ring about it, hung left of the text edge.
 * Narrow, it is a bar that stays under the top bar: "Contents" and search.
 * The list opens over the page, not in it, with the page's own sections first.
 */
import type { MarkdownHeading } from 'astro';

import DocsSearch from './DocsSearch.astro';
import PageSections from './PageSections.astro';
import { DOCS_TREE } from '../data/docsTree';
import { sitePath } from '../utils/sitePath';

type Props = { current: string; sections: readonly MarkdownHeading[] };

const { current, sections } = Astro.props;
---

<nav class="docs-nav small" aria-label="Docs" data-pagefind-ignore>
  <DocsSearch />
  <details open data-docs-menu>
    <summary class="ring small">Contents</summary>
    <div class="tree">
      {
        sections.length > 0 && (
          <div class="here">
            <p class="group" id="docs-nav-here">
              On this page
            </p>
            <nav aria-labelledby="docs-nav-here">
              <PageSections sections={sections} />
            </nav>
          </div>
        )
      }
      {
        DOCS_TREE.map((group) => (
          <>
            <p class="group" id={`docs-nav-${group.name.toLowerCase()}`}>
              {group.name}
            </p>
            <ul aria-labelledby={`docs-nav-${group.name.toLowerCase()}`}>
              {group.pages.map((page) => (
                <li>
                  {page.status === 'live' ? (
                    <a href={sitePath(page.path)} aria-current={page.path === current ? 'page' : undefined}>
                      {page.title}
                    </a>
                  ) : (
                    <span class="planned">
                      {page.title}
                      <span class="unseen"> (not written yet)</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </>
        ))
      }
      <p class="legend" aria-hidden="true">The dimmer pages are not written yet.</p>
    </div>
  </details>
  <!-- Before the first paint, so a phone never shows the list open and then folds it. Without script it stays open. -->
  <script is:inline>
    if (matchMedia('(max-width: 900px)').matches) document.currentScript.previousElementSibling.open = false;
  </script>
</nav>

<script>
  // The list is one element at every width: wide, it must be open, since its summary is not shown there.
  const menu = document.querySelector<HTMLDetailsElement>('[data-docs-menu]');
  const narrow = matchMedia('(max-width: 900px)');
  if (menu) {
    narrow.addEventListener('change', () => (menu.open = !narrow.matches));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !narrow.matches || !menu.open) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
    // The open list lies over the page: a jump within the page, or a tap on the page, puts it away.
    document.addEventListener('click', (event) => {
      if (!narrow.matches || !menu.open) return;
      const target = event.target as Element;
      if (!menu.contains(target) || target.closest('a[href^="#"]')) menu.open = false;
    });
  }
</script>

<style>
  /* The marker of a link and how far left of the text edge it hangs: the small ring's own two measures. */
  .docs-nav {
    --mark: 0.6875rem;
    --hang: calc(var(--mark) + 0.625rem);
    line-height: 1.3;
  }

  summary {
    display: none;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* 20px at every width: the display face's floor, which the phone's body size is under. */
  .group {
    max-width: none;
    margin: 1.75rem 0 0.375rem;
    font: var(--weight-display) 1.25rem / 1.1 var(--font-family-display);
    color: var(--color-fg);
  }

  /* Wide, the page's own sections stand beside the text or are left out (layouts/Docs.astro). */
  .here {
    display: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a,
  .planned {
    position: relative;
    display: block;
    padding-block: 0.375rem;
  }

  a {
    color: var(--site-text-muted);
    text-decoration: none;
  }

  a:hover,
  a[aria-current] {
    color: var(--color-fg);
  }

  /* A ring where the pointer is; the point with its ring where the reader is. */
  a::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--hang));
    top: 50%;
    width: var(--mark);
    height: var(--mark);
    margin-top: calc(var(--mark) / -2);
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    opacity: 0;
  }

  a:hover::before,
  a:focus-visible::before,
  a[aria-current]::before {
    opacity: 1;
  }

  a[aria-current]::before {
    width: 0.3125rem;
    height: 0.3125rem;
    margin: -0.15625rem 0 0 0.1875rem;
    border: 0;
    background: var(--color-accent);
    box-shadow:
      0 0 0 0.1875rem var(--color-bg),
      0 0 0 0.25rem var(--color-accent);
  }

  .planned,
  .legend {
    color: var(--site-text-faint);
  }

  .legend {
    max-width: none;
    margin: 2rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-divider);
  }

  /* The search control's ring hangs where the list's markers do, so its label starts on the same edge. */
  .docs-nav > :global(.search-open) {
    margin-left: calc(-1 * var(--hang));
  }

  /*
   * Wide: a column that stays while the page scrolls and scrolls by itself when the window is shorter than the
   * list. The left padding is the room its markers hang in, which a scrolling box would otherwise cut off.
   */
  @media (min-width: 901px) {
    .docs-nav {
      position: sticky;
      top: var(--nav-height);
      align-self: start;
      max-height: calc(100svh - var(--nav-height));
      margin-left: calc(-1 * var(--hang) - 0.5rem);
      /* The search control's label stands on the line of the page's own first line, the group over its title. */
      padding: 2.875rem 0.5rem 3rem calc(var(--hang) + 0.5rem);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--border-divider) transparent;
    }
  }

  /*
   * Narrow: one row that stays under the top bar, the list's disclosure on the left and search on the right. The
   * open list hangs from the row over the page and scrolls by itself, so opening it moves nothing.
   */
  @media (max-width: 900px) {
    .docs-nav {
      position: sticky;
      top: var(--nav-height);
      z-index: 3;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      margin-inline: calc(-1 * var(--gutter));
      padding: 0.5rem var(--gutter);
      border-bottom: 1px solid var(--border-divider);
      background: var(--color-bg);
    }

    .here {
      display: block;
    }

    /* Over the list's own row, which is as wide as the page so that the open list is. */
    .docs-nav > :global(.search-open) {
      grid-area: 1 / 2;
      align-self: start;
      z-index: 1;
      margin-left: 0;
    }

    details {
      grid-area: 1 / 1 / auto / -1;
    }

    summary {
      display: inline-flex;
    }

    .tree {
      position: absolute;
      inset: 100% 0 auto;
      max-height: calc(100svh - var(--nav-height) - var(--docs-bar));
      padding: 0 var(--gutter) 1.5rem calc(var(--gutter) + var(--hang));
      border-bottom: 1px solid var(--border-divider);
      background: var(--color-bg);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .group {
      margin-top: 1.5rem;
    }

    a,
    .planned {
      padding-block: 0.75rem;
    }
  }
</style>
