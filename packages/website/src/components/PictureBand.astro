---
/*
 * PictureBand — a section whose ground is one picture, with the words on its
 * dark side (`words`). Wide, the picture fills the band and fades into the
 * page; narrow, it comes first and the words follow under it. The picture's
 * label (a ShotCaption among the words) leaves the words and is set against
 * the picture: along the band's foot when wide, straight under it when narrow.
 * `gap="none"` makes it a page's opening section: it fits the first screen, and
 * narrow its title and lead come before the picture. `zoom` enlarges a wide
 * picture past the right edge, to bring a centred subject out from under the words.
 */
import Shot from './Shot.astro';

type Props = {
  id: string;
  tall?: string;
  words?: 'left' | 'right';
  gap?: 'none' | 'half' | 'full';
  eager?: boolean;
  zoom?: number;
};

const { id, tall, words = 'left', gap = 'full', eager = false, zoom = 1 } = Astro.props;
---

<section
  class:list={['band', `words-${words}`, `gap-${gap}`, zoom !== 1 && 'zoomed']}
  data-opening={gap === 'none'}
  style={`--zoom:${zoom}`}
>
  <div class="back">
    <Shot id={id} tall={tall} sizes="100vw" eager={eager} />
  </div>
  <div class="wrap copy">
    <slot />
  </div>
</section>

<style>
  .band {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(56.25vw, 92svh);
    overflow-x: clip;
    background: #000;
  }

  .gap-half {
    margin-top: calc(var(--section-space) / 2);
  }

  .gap-full {
    margin-top: var(--section-space);
  }

  .back {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .back :global(img) {
    display: block;
    width: calc(100% * var(--zoom));
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }

  .words-right .back :global(img) {
    object-position: 30% 50%;
  }

  /* No frame edge: the picture fades into the page above and below, and into the words beside it. */
  .back::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0) 16%, rgb(0 0 0 / 0) 84%, #000 100%),
      linear-gradient(90deg, rgb(0 0 0 / 0.88) 0%, rgb(0 0 0 / 0.6) 34%, rgb(0 0 0 / 0) 58%);
  }

  .words-right .back::after {
    background:
      linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0) 16%, rgb(0 0 0 / 0) 84%, #000 100%),
      linear-gradient(270deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.65) 32%, rgb(0 0 0 / 0) 56%);
  }

  /*
   * A header has no section above it to fade out of. Its words include small dim text, so the dark side holds 0.8
   * as far as the words reach (40% of the width): the least that keeps 4.5:1 over a white star.
   */
  .gap-none .back::after {
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0) 84%, #000 100%),
      linear-gradient(90deg, rgb(0 0 0 / 0.8) 0%, rgb(0 0 0 / 0.8) 40%, rgb(0 0 0 / 0) 64%);
  }

  @media (min-width: 901px) {
    /* Never taller than the picture's own shape, so a tall window does not crop it to a strip. */
    .gap-none {
      min-height: min(56.25vw, var(--first-screen));
    }

    .gap-none .copy {
      padding-top: var(--open-top);
    }

    .gap-none .copy > :global(.caption) {
      --caption-rise: var(--open-rise);
    }

    .gap-none .copy > :global(*) {
      max-width: min(27rem, 38vw);
    }

    /* A page's title is large text and may run past the words' column, over the picture: two lines, never three. */
    .gap-none .copy > :global(h1) {
      max-width: min(50rem, 60vw);
    }
  }

  .band .copy > :global(h1) {
    text-shadow: 0 0 1.5rem rgb(0 0 0 / 0.6);
  }

  /*
   * A column, so the label can leave the words: the two auto margins centre the words in the room above the
   * label and push the label to the foot, where the picture has faded to black.
   */
  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-self: stretch;
    width: 100%;
    padding-block: 5rem 2rem;
  }

  .copy > :global(:first-child) {
    margin-top: auto;
  }

  /* A control is as wide as its words, not as the column. */
  .copy > :global(a) {
    align-self: flex-start;
  }

  .words-right .copy > :global(*) {
    margin-left: 58%;
  }

  .band .copy > :global(.caption) {
    --caption-foot: '';
    max-width: none;
    margin: auto 0 0;
    padding-top: var(--caption-rise, 4rem);
  }

  /* On a short window an opening section's paragraphs under the lead are set small: at 16px Jost is 400. */
  @media (min-width: 901px) and (max-height: 720px) {
    .gap-none .copy > :global(p:not(.say)) {
      font-size: var(--text-small);
      font-weight: var(--weight-small);
      line-height: 1.5;
    }
  }

  /* Narrow: the picture first, fading into the words below it. */
  @media (max-width: 900px) {
    .band {
      display: block;
      min-height: 0;
    }

    /* The title has the whole column: a page's own narrower measure would push it to a third line. */
    .band .copy > :global(h1) {
      max-width: none;
    }

    .back {
      position: relative;
    }

    .back :global(img) {
      width: 100%;
      height: auto;
      object-position: center;
    }

    .back::after,
    .gap-none .back::after,
    .words-right .back::after {
      background: linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0) 14%, rgb(0 0 0 / 0) 68%, #000 100%);
    }

    .copy {
      margin-top: -1.5rem;
      padding-block: 0;
    }

    .copy > :global(:first-child) {
      margin-top: 0;
    }

    .words-right .copy > :global(*) {
      margin-left: 0;
    }

    .band .copy > :global(.caption) {
      --caption-foot: none;
      order: -1;
      margin-bottom: 2.5rem;
      padding-top: 0;
    }

    /*
     * An opening section: the words' children become the band's own rows, so the title and the lead can stand
     * above the picture, where a phone's first screen shows what page this is; the label and the rest follow it.
     */
    .gap-none {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .gap-none .copy {
      display: contents;
    }

    .gap-none .copy > :global(*) {
      order: 2;
      margin-inline: var(--gutter);
    }

    .gap-none .copy > :global(a) {
      justify-self: start;
    }

    .gap-none .copy > :global(h1) {
      order: -2;
      margin-top: 2rem;
    }

    .gap-none .copy > :global(.say) {
      order: -1;
      margin-bottom: 0.5rem;
    }

    .gap-none .copy > :global(.caption) {
      order: 1;
      width: auto;
      margin: -1.5rem var(--gutter) 2.5rem;
    }

    /* A zoomed picture is cut taller here instead of wider, which enlarges its centre as much. */
    .zoomed .back :global(img) {
      aspect-ratio: calc(16 / 9 / var(--zoom));
    }
  }
</style>
