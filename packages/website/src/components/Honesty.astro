---
import ObjLink from './ObjLink.astro';
import Shot from './Shot.astro';
import ShotCaption from './ShotCaption.astro';
import { HONESTY } from '../data/honesty';
import { HONESTY_BINS } from '../data/honestyBins';
import { sitePath } from '../utils/sitePath';
---

<section class="wrap section honest grid" id="honest">
  <div class="intro grid">
    <h2>What is measured, derived and drawn</h2>
    <ObjLink hang size="small" href={sitePath('/science/')}>The science behind skymap</ObjLink>
  </div>
  {
    HONESTY_BINS.map((bin) => (
      <div class="bin">
        <h3>{bin.title}</h3>
        <p class="gloss small">{bin.gloss}</p>
        <figure>
          <Shot id={bin.shot} sizes="(max-width: 900px) calc(100vw - 2.5rem), (max-width: 1239px) calc(33.4vw - 3.75rem), 22rem" />
          <figcaption>
            <ShotCaption id={bin.shot} />
          </figcaption>
        </figure>
        <ul class="small">
          {HONESTY[bin.id].map((item) => (
            <li>
              <a href={item.href}>{item.text}</a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .honest {
    row-gap: 2.5rem;
  }

  .intro {
    align-items: baseline;
  }

  h2 {
    margin-bottom: 0;
  }

  /* Thirds of the page grid; the link beside the heading stands over the third. */
  @media (min-width: 901px) {
    .bin {
      grid-column: span 4;
      --cols: 4;
    }

    h2 {
      grid-column: span 8;
    }

    .intro > :global(a) {
      grid-column: 9 / -1;
      justify-self: start;
    }
  }

  /* One picture heads each list: an example of the word, with its own address. */
  figure {
    margin: 0 0 1rem;
  }

  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    min-height: 6em;
    margin-top: 0.5rem;
  }

  .gloss {
    min-height: 3em;
    margin: 0 0 0.75rem;
    color: var(--site-text-dim);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: block;
    padding-block: 0.625rem;
    color: var(--site-text-muted);
  }

  @media (max-width: 900px) {
    .intro > :global(a) {
      justify-self: start;
    }

    .gloss,
    figcaption {
      min-height: 0;
    }
  }
</style>
