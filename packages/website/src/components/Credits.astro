---
/* Credits — who made the images and catalogues Home shows, each linked to its source and licence. */
import { DATA_CREDITS, IMAGE_CREDITS } from '../data/credits';
import { sitePath } from '../utils/sitePath';

const groups = [
  { label: 'Images', credits: IMAGE_CREDITS },
  { label: 'Catalogues', credits: DATA_CREDITS },
];
---

<section class="credits" id="credits" aria-labelledby="credits-title">
  <h2 id="credits-title">Credits</h2>
  {
    groups.map((group) => (
      <p>
        <b>{group.label}.</b>{' '}
        {group.credits.map((credit, i) => (
          <>
            {i > 0 && '; '}
            <a href={credit.href}>{credit.name}</a> (
            {credit.licenceHref ? <a href={credit.licenceHref}>{credit.licence}</a> : credit.licence})
          </>
        ))}
        .
      </p>
    ))
  }
  <p>Full credits, with the acknowledgements some releases require, are on the <a href={sitePath('/docs/credits/')}>credits page</a>.</p>
</section>

<style>
  .credits {
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--border-divider);
    font-size: var(--text-small);
    color: var(--site-text-dim);
  }

  h2 {
    font-size: var(--text-h3);
  }

  p {
    max-width: none;
    margin-block: 0 0.75rem;
  }

  b {
    font-weight: 400;
    color: var(--site-text-muted);
  }
</style>
