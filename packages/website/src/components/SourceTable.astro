---
/*
 * SourceTable — every data source, twice in the page and once on screen. Wide,
 * it is a table to read across, its rows laid on the page grid so its columns
 * are the page's; the ARIA roles keep it a table to a screen reader, since CSS
 * has taken the table display away. Narrow, the table is gone and the same
 * rows are a list of closed disclosures, a source's name and what it gives
 * showing: two dozen stacked tables were eleven phone screens. No script. The
 * slot is for notes on how to read it, set under a rule at its foot. A
 * source's name leads to its data page, which has its terms in full and the
 * link to the source itself.
 */
import ObjLink from './ObjLink.astro';
import { DATA_SOURCES } from '../data/dataSources';
import { dataRowPath } from '../utils/dataRowPath';
import { sitePath } from '../utils/sitePath';

const groups = [...new Set(DATA_SOURCES.map((row) => row.group))].map((name) => ({
  name,
  rows: DATA_SOURCES.filter((row) => row.group === name),
}));
const COLUMNS = { release: 'Release we read', rows: 'Rows we read', drawn: 'We draw', licence: 'Licence' } as const;
---

<table role="table" class="small">
  <caption>Data sources in skymap, as the code read them on 6 October 2026</caption>
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">Source and what it gives</th>
      <th role="columnheader" scope="col">{COLUMNS.release}</th>
      <th role="columnheader" scope="col" class="num">{COLUMNS.rows}</th>
      <th role="columnheader" scope="col" class="num">{COLUMNS.drawn}</th>
      <th role="columnheader" scope="col">{COLUMNS.licence}</th>
    </tr>
  </thead>
  {
    groups.map((group) => (
      <tbody role="rowgroup">
        <tr role="row" class="group">
          <th role="columnheader" scope="rowgroup" colspan="5">
            {group.name}
          </th>
        </tr>
        {group.rows.map((row) => (
          <tr role="row">
            <th role="rowheader" scope="row">
              <a href={sitePath(dataRowPath(row.entries))}>{row.name}</a>
              <span class="gives">{row.gives}</span>
            </th>
            <td role="cell">{row.release}</td>
            <td role="cell" class="num">
              {row.rows ?? <span class="sr">not counted</span>}
            </td>
            <td role="cell" class="num">
              {row.drawn ?? <span class="sr">not counted</span>}
            </td>
            <td role="cell">
              {row.licence} <a class="evidence" href={row.href}>Its own site</a>{' '}
              <a class="evidence" href={row.evidence}>Our record</a>
            </td>
          </tr>
        ))}
      </tbody>
    ))
  }
</table>

<div class="list small">
  {
    groups.map((group) => (
      <section>
        <h3>{group.name}</h3>
        {group.rows.map((row) => (
          <details>
            <summary class="ring small">
              <span>
                <b>{row.name}</b>
                <span class="gives">{row.gives}</span>
              </span>
            </summary>
            <dl>
              {(['release', 'rows', 'drawn', 'licence'] as const).map(
                (key) =>
                  row[key] && (
                    <div>
                      <dt>{COLUMNS[key]}</dt>
                      <dd>{row[key]}</dd>
                    </div>
                  ),
              )}
            </dl>
            <p class="links">
              <ObjLink size="small" href={sitePath(dataRowPath(row.entries))}>
                {row.name}
              </ObjLink>
              <ObjLink size="small" href={row.href}>
                Its own site
              </ObjLink>
              <ObjLink size="small" href={row.evidence}>
                Our record
              </ObjLink>
            </p>
          </details>
        ))}
      </section>
    ))
  }
</div>
{Astro.slots.has('default') && <div class="notes small tap-links"><slot /></div>}

<style>
  table,
  thead,
  tbody,
  th,
  td {
    display: block;
  }

  table {
    font-variant-numeric: tabular-nums;
  }

  .list {
    display: none;
  }

  /* Three columns of the page grid for the source, three for the release, two and one for the counts, three for the licence. */
  tr {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    border-top: 1px solid var(--border-divider);
  }

  tr > * {
    grid-column: span 3;
  }

  tr > :nth-child(3) {
    grid-column: span 2;
  }

  /* A count is wider than one column and is set from its right edge: a flex line, so it runs back into the gap. */
  tr > :nth-child(4) {
    grid-column: span 1;
  }

  tr > .num {
    display: flex;
    justify-content: flex-end;
    white-space: nowrap;
  }

  tr.group,
  thead tr {
    border-top: 0;
  }

  tr.group > * {
    grid-column: 1 / -1;
  }

  caption,
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  th,
  td {
    padding-block: 0.875rem;
    text-align: left;
    font-weight: var(--weight-small);
    color: var(--site-text-muted);
  }

  thead th {
    color: var(--site-text-dim);
  }

  .group th,
  h3 {
    padding-top: 2.5rem;
    font: var(--weight-display) var(--text-h3) / 1.1 var(--font-family-display);
    color: var(--color-fg);
  }

  tbody:first-of-type .group th {
    padding-top: 1rem;
  }

  th[scope='row'] a {
    color: var(--color-fg);
  }

  .gives {
    display: block;
    margin-top: 0.25rem;
  }

  .evidence {
    white-space: nowrap;
  }

  .notes {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-divider);
  }

  .notes :global(p) {
    max-width: 34rem;
    margin-bottom: 0.75rem;
    color: var(--site-text-dim);
  }

  /* Narrow: the list in the table's place. */
  @media (max-width: 900px) {
    table {
      display: none;
    }

    .list {
      display: block;
      font-variant-numeric: tabular-nums;
    }

    h3 {
      margin: 0;
      padding-bottom: 0.75rem;
    }

    section:first-child h3 {
      padding-top: 0;
    }

    details {
      border-top: 1px solid var(--border-divider);
    }

    /* The whole row opens it; the ring is filled while it is open (styles/site.css). */
    summary {
      display: flex;
      align-items: baseline;
      width: 100%;
      padding-block: 0.875rem;
      list-style: none;
      color: var(--site-text-muted);
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary b {
      font-weight: inherit;
      color: var(--color-fg);
    }

    dl {
      margin: 0;
      padding-left: 1.3125rem;
    }

    dl > div {
      padding-bottom: 0.625rem;
    }

    dt {
      color: var(--site-text-dim);
    }

    dd {
      margin: 0;
      color: var(--site-text-muted);
    }

    .links {
      display: flex;
      flex-wrap: wrap;
      gap: 0 2rem;
      max-width: none;
      margin: 0 0 0.75rem;
      padding-left: 1.3125rem;
    }
  }
</style>
