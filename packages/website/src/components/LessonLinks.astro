---
/*
 * LessonLinks — the ready-made lesson links as one grid of small cards: the
 * picture, its topic, a ring that opens it, one question, what in the picture
 * is data and what is drawn, and a control that copies the address. Four to a
 * row when wide; on an upright phone each is a row with its picture small on
 * the left.
 */
import ObjLink from './ObjLink.astro';
import Shot from './Shot.astro';
import { appLink } from '../data/appLink';
import { LESSON_TOPICS } from '../data/lessons';
import { siteShot } from '../data/siteShot';

// A card has no room for the picture's full label: it keeps the line that says what is data and what is drawn.
const drawn = (id: string) => [siteShot(id).drawn, siteShot(id).credit && `${siteShot(id).credit}.`].filter(Boolean).join(' ');
---

<ul>
  {
    LESSON_TOPICS.flatMap((topic) =>
      topic.lessons.map((lesson) => (
        <li>
          <a class="picture" href={appLink(lesson.hash)} tabindex="-1" aria-hidden="true">
            <Shot id={lesson.shot} sizes="(max-width: 600px) 30vw, (max-width: 900px) 46vw, 17rem" alt="" />
          </a>
          <div class="words">
            <p class="topic small">{topic.title}</p>
            <ObjLink href={appLink(lesson.hash)}>{lesson.title}</ObjLink>
            <p class="ask small">{lesson.ask}</p>
            <p class="drawn small">{drawn(lesson.shot)}</p>
          </div>
        </li>
      )),
    )
  }
</ul>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    min-width: 0;
  }

  .picture {
    display: block;
    margin-bottom: 0.875rem;
  }

  .picture :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .topic {
    margin: 0;
    color: var(--site-text-dim);
  }

  .ask {
    margin: 0.25rem 0 0.5rem;
    color: var(--color-fg);
  }

  .drawn {
    margin: 0;
    color: var(--site-text-dim);
  }

  @media (max-width: 1100px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    ul {
      grid-template-columns: 1fr;
      gap: 0;
    }

    li {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1rem;
      padding-block: 1.5rem;
      border-top: 1px solid var(--border-divider);
    }

    .picture {
      margin: 0.375rem 0 0;
    }
  }
</style>
