---
/*
 * The contact form when it is open, and the note that says it is not when it is
 * closed. An MDX page cannot do this itself: Astro finds a `client:` island only
 * where the tag stands in the text, not inside a `{ ... ? ... : ... }`.
 */
import ContactClosed from '../components/ContactForm/ContactClosed.tsx';
import ContactForm from '../components/ContactForm/ContactForm.tsx';
import { CONTACT_ENDPOINT, ISSUES_URL, TURNSTILE_SITE_KEY } from '../data/contact';
import { sitePath } from '../utils/sitePath';
---

{
  CONTACT_ENDPOINT && TURNSTILE_SITE_KEY ? (
    <ContactForm
      client:visible
      endpoint={CONTACT_ENDPOINT}
      siteKey={TURNSTILE_SITE_KEY}
      privacyHref={sitePath('/privacy/')}
      issuesHref={ISSUES_URL}
    />
  ) : (
    <ContactClosed privacyHref={sitePath('/privacy/')} issuesHref={ISSUES_URL} />
  )
}
