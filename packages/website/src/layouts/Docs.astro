---
/*
 * Docs — the document shell of a docs page, like Base for every page: it makes
 * the three islands of the docs layout (the contents, the list of the page's
 * own headings and the figure sheet) and hands them to DocsLayout, because a
 * React component cannot make an island. The page itself is DocsLayout.
 */
import type { MarkdownHeading } from 'astro';

import DocsNav from '../components/DocsNav/DocsNav.tsx';
import FigureSheet from '../components/FigureSheet/FigureSheet.tsx';
import PageSections from '../components/PageSections/PageSections.tsx';
import { loadDocsTree } from '../utils/loadDocsTree';
import { breadcrumbJsonLd } from '../utils/breadcrumbJsonLd';
import { docsPlace } from '../utils/docsPlace';
import { tocSections } from '../utils/tocSections';
import Base from './Base.astro';
import DocsLayout from './DocsLayout/DocsLayout.tsx';

type Props = {
  path: string;
  description: string;
  headings: readonly MarkdownHeading[];
  factIds: readonly string[];
};

const { path, description, headings, factIds } = Astro.props;
const tree = await loadDocsTree();
const place = docsPlace(tree, path);
const { title } = place.page;
const sections = tocSections(headings);
---

<Base
  title={`${title} | Skymap docs`}
  description={description}
  skipTo="page"
  jsonLd={[
    breadcrumbJsonLd(Astro.site!, [
      { name: 'Docs', path: '/docs/' },
      { name: title, path },
    ]),
  ]}
>
  <DocsLayout place={place} description={description} headings={headings} factIds={factIds}>
    <DocsNav slot="nav" current={path} sections={sections} groups={tree.map(({ name, pages }) => ({ name, pages }))} client:visible />
    {sections.length > 0 && <PageSections slot="toc" sections={sections} client:visible />}
    <FigureSheet slot="sheet" client:idle />
    <slot />
  </DocsLayout>
</Base>
