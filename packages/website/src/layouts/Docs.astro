---
/*
 * Docs — one docs page on the site's twelve columns: the docs' contents in
 * the first three, the text in the next six (seven until the window has room
 * for the third part), and the page's own headings in the last three when it
 * has four or more. Narrow, the contents fold away above the text. The page's
 * place comes from its row in data/docsTree.ts: the group over its title,
 * previous and next within the group, and the landing page it links back up to.
 */
import type { MarkdownHeading } from 'astro';

import Base from './Base.astro';
import DocBody from '../components/DocBody.astro';
import DocsNav from '../components/DocsNav.astro';
import ObjLink from '../components/ObjLink.astro';
import Sources from '../components/Sources.astro';
import { DOCS_TREE } from '../data/docsTree';
import { breadcrumbJsonLd } from '../utils/breadcrumbJsonLd';
import { docsPlace } from '../utils/docsPlace';
import { landingLabel } from '../utils/landingLabel';
import { sitePath } from '../utils/sitePath';

type Props = {
  path: string;
  title: string;
  description: string;
  headings: readonly MarkdownHeading[];
  factIds: readonly string[];
};

// A shorter page is read in less time than its list of headings would take to scan.
const TOC_FROM = 4;

const { path, title, description, headings, factIds } = Astro.props;
const { group, page, previous, next } = docsPlace(DOCS_TREE, path);
const up = page.up ?? group.up;
const sections = headings.filter((heading) => heading.depth === 2);
const turns = [
  { page: previous, rel: 'prev', label: `Before this, in ${group.name}` },
  { page: next, rel: 'next', label: `After this, in ${group.name}` },
].flatMap((turn) => (turn.page ? [{ ...turn, page: turn.page }] : []));
---

<Base
  title={`${title} | skymap docs`}
  description={description}
  jsonLd={[
    breadcrumbJsonLd(Astro.site!, [
      { name: 'Docs', path: '/docs/' },
      { name: title, path },
    ]),
  ]}
>
  <div class="wrap grid docs">
    <DocsNav current={path} />

    <article class="page" data-pagefind-meta={`group:${group.name}`}>
      <header data-opening>
        <p class="where small" data-pagefind-ignore>
          <a href={sitePath('/docs/')}>Docs</a>
          <span aria-hidden="true">/</span>
          <a href={`${sitePath('/docs/')}#${group.name.toLowerCase()}`}>{group.name}</a>
        </p>
        <h1>{title}</h1>
        <p class="say">{description}</p>
      </header>

      <DocBody><slot /></DocBody>

      <footer data-pagefind-ignore>
        {
          turns.length > 0 && (
            <nav class="turns grid" aria-label="Previous and next page">
              {turns.map((turn) => (
                <p>
                  <span class="small">{turn.label}</span>
                  <ObjLink hang rel={turn.rel} href={sitePath(turn.page.path)}>
                    {turn.page.title}
                  </ObjLink>
                </p>
              ))}
            </nav>
          )
        }
        <div class="link-row">
          <ObjLink hang size="small" href={sitePath(up)}>{landingLabel(up)}</ObjLink>
          <ObjLink hang size="small" href={sitePath('/docs/')}>All of the docs</ObjLink>
        </div>
        <Sources ids={factIds} all />
      </footer>
    </article>

    {
      sections.length >= TOC_FROM && (
        <nav class="toc small" aria-labelledby="toc-label" data-pagefind-ignore>
          <p id="toc-label">On this page</p>
          <ol>
            {sections.map((section) => (
              <li>
                <a href={`#${section.slug}`}>{section.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>
</Base>

<style>
  .page {
    padding-block: 2rem 5rem;
  }

  header {
    margin-bottom: 3rem;
  }

  .where {
    display: flex;
    gap: 0.5rem;
    max-width: none;
    margin: 0 0 1.25rem;
    color: var(--site-text-faint);
  }

  .where a {
    color: var(--site-text-dim);
    text-decoration: none;
  }

  .where a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* A reading page's title: the largest type on it, and well under a landing page's, whose title has a picture to hold. */
  header h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(2.5rem, 4.2vw, 3.5rem);
  }

  header .say {
    max-width: none;
    margin: 0;
    font-size: var(--text-body);
    text-wrap: pretty;
  }

  footer {
    margin-top: 4.5rem;
  }

  .turns {
    row-gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-divider);
  }

  .turns p {
    display: grid;
    max-width: none;
    margin: 0;
  }

  .turns span {
    color: var(--site-text-dim);
  }

  footer .link-row {
    margin-block: 2rem 2.5rem;
  }

  .toc {
    display: none;
  }

  @media (min-width: 901px) {
    .docs > :global(.docs-nav) {
      grid-column: span 3;
    }

    .page {
      grid-column: 4 / span 7;
      --cols: 7;
      padding-block: 3.5rem 7.5rem;
    }

    .turns p {
      grid-column: span 3;
    }
  }

  /* Room for the third part: the text gives up a column and the page's headings stand beside it. */
  @media (min-width: 1200px) {
    .page {
      grid-column: 4 / span 6;
      --cols: 6;
    }

    .toc {
      display: block;
      grid-column: 10 / -1;
      position: sticky;
      top: var(--nav-height);
      align-self: start;
      max-height: calc(100svh - var(--nav-height));
      padding-block: 3.625rem 3rem;
      overflow-y: auto;
      line-height: 1.3;
    }
  }

  .toc p {
    margin: 0 0 0.5rem;
    color: var(--site-text-dim);
  }

  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: block;
    padding-block: 0.375rem;
    color: var(--site-text-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-fg);
    text-decoration: underline;
  }
</style>
