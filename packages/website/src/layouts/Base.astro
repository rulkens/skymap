---
import '@fontsource-variable/jost/wght.css';
import '../styles/site.css';
// The two faces every page paints with at once; preloaded so the first paint is the last swap.
import jostUrl from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import displayUrl from '../assets/fonts/cormorant-garamond-600-site.woff2?url';
import BaseLayout from './BaseLayout/BaseLayout.tsx';
import NavMenu from '../components/Nav/NavMenu.tsx';
import LightLine from '../components/Footer/LightLine.tsx';
import { fact } from '../data/fact';
import DevOverlay from '../dev/overlay/DevOverlay/DevOverlay.tsx';
import { INDEXABLE } from '../data/site';
import { shareImage } from '../utils/shareImage';

type Props = {
  title: string;
  description: string;
  /** A shot id of data/siteShots.ts for link previews; the site card when absent. */
  image?: string;
  /** The page's job, for the dev review bar only; absent on pages made from data. */
  job?: string;
  /** Where a job is written when it is not the page's front matter, for the review bar's note. */
  jobSetIn?: string;
  jsonLd?: readonly Record<string, unknown>[];
  heroNav?: boolean;
  /** The id "Skip to content" goes to, where a layout has its own contents before the text. */
  skipTo?: string;
};

const { title, description, image, job, jobSetIn, jsonLd = [], heroNav = false, skipTo = 'main' } = Astro.props;
const card = await shareImage(image);
// Shared root files stay root-absolute (the main shell serves them); the canonical and the card need the site origin.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(card.src, Astro.site).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" as="font" type="font/woff2" href={displayUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jostUrl} crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!INDEXABLE && <meta name="robots" content="noindex" />}
    {INDEXABLE && <link rel="sitemap" href="/sitemap.xml" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skymap" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(card.width)} />
    <meta property="og:image:height" content={String(card.height)} />
    <meta property="og:image:alt" content={card.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={card.alt} />
    {import.meta.env.DEV && job !== undefined && <meta name="skymap:job" content={job} data-set-in={jobSetIn} />}
    <!-- `<` is escaped so a string containing `</script>` cannot close the block. -->
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
    <slot name="head" />
  </head>
  <body>
    <BaseLayout path={Astro.url.pathname} skipTo={skipTo} hero={heroNav}>
      <NavMenu slot="menu" path={Astro.url.pathname} />
      <LightLine slot="light" text={fact('speed-of-light').short!} />
      <slot />
    </BaseLayout>
    <script>
      import '../components/Footer/lightLine.client.ts';
      import '../components/CopyButton/copyButtons.client.ts';
      import '../components/Remark/remarkLines.client.ts';
    </script>
    {
      import.meta.env.DEV && (
        <>
          {/* Astro's dev toolbar strips the source attributes once it boots, so describeElement reads these copies, taken before the island runs. */}
          <script is:inline>
            window.__feedbackSources = new WeakMap();
            for (const el of document.querySelectorAll('[data-astro-source-file]')) {
              window.__feedbackSources.set(el, [
                el.getAttribute('data-astro-source-file'),
                el.getAttribute('data-astro-source-loc'),
              ]);
            }
          </script>
          <DevOverlay client:only="react" />
        </>
      )
    }
  </body>
</html>
