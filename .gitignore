# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
# Vite ships compiled assets into dist/ and a transient cache into .vite/.
# TypeScript's incremental-build state lives in *.tsbuildinfo files.
dist/
.vite/
*.tsbuildinfo

# ── Test artefacts ────────────────────────────────────────────────────────────
coverage/
.nyc_output/
.vitest-cache/

# ── Environment files ─────────────────────────────────────────────────────────
# Anything ending in `.local` is per-developer and should never be checked in.
.env
.env.local
.env.*.local

# ── OS clutter ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / IDE state ────────────────────────────────────────────────────────
# JetBrains (.idea) and VS Code (.vscode) directories carry per-user state we
# don't want shared.  Some `.idea/*.xml` files were accidentally committed
# earlier in the project's history; new files won't be tracked, but those
# already-tracked files stay in git until removed explicitly via
# `git rm --cached .idea/<file>`.
.idea/
.vscode/
*.swp
*.swo
*~

# ── Catalog data (bulky, externally sourced or rebuildable) ───────────────────
# Top-level `/data/` holds the raw downloaded catalog files (2MRS, GLADE,
# SDSS CSV exports), the per-survey `.bin` build artefacts, and small
# `sample.*` fixtures used by ad-hoc dev scripts.  At ~880 MB it is far
# too large for git and is fully reproducible by re-running the parsers
# under tools/ on freshly downloaded source files.
#
# Leading `/` anchors the rule to the repo root so it does NOT match
# `src/data/` (TypeScript source) or `tests/data/` (test fixtures and
# unit tests).  An unanchored `data/` would silently swallow new files
# in those directories — see the implementer's note on Task 1 of the
# colour-index plan, which hit exactly that trap.
/data/

# `public/data/` is the Vite-served copy of the built `.bin` files (~100 MB).
# Generated by `npm run build:bins` (or equivalent) — never hand-edited.
/public/data/

# 2MASS XSC PA/axis-ratio cache fetched by `npm run fetch-2mass-xsc`. Already
# covered by `/data/` above, but listed explicitly so future readers see it
# alongside the other catalog artefacts. ~1 MB of tabular data; rebuildable.
data/raw/2mass_xsc_pa.csv

# ── Claude Code per-developer state ───────────────────────────────────────────
# `settings.local.json` accumulates this developer's locally-granted tool
# permissions; the shared `settings.json` (when it exists) stays tracked.
.claude/settings.local.json
